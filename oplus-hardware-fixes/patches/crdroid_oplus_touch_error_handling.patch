diff --git a/aidl/touch/touch-headers/OplusTouchConstants.h b/aidl/touch/touch-headers/OplusTouchConstants.h
index 2fe4918..ea60e74 100644
--- a/aidl/touch/touch-headers/OplusTouchConstants.h
+++ b/aidl/touch/touch-headers/OplusTouchConstants.h
@@ -5,6 +5,9 @@
 
 #pragma once
 
+#include <charconv>
+#include <string>
+
 namespace OplusTouchConstants {
 
 // Device IDs
@@ -21,4 +24,24 @@ constexpr int GAME_SWITCH_ENABLE_NODE = 26;
 constexpr int REPORT_RATE_NODE = 182;
 constexpr int GLOVE_MODE_ENABLE_NODE = 192;
 
+// proc_gesture_control_indep_write silently ignores longer decimal strings.
+constexpr size_t GESTURE_MASK_MAX_BYTES = 8;
+
+// The driver reports the gesture mask as hex; keep the existing decimal writer.
+inline bool ParseGestureMask(const std::string& value, int* mask) {
+    auto first = value.find_first_not_of(" \t\r\n");
+    if (first == std::string::npos) return false;
+    const auto end = value.find_last_not_of(" \t\r\n") + 1;
+    if (value[first] == '-') return false;
+    if ((end - first >= 2) && (value[first] == '0') &&
+        ((value[first + 1] == 'x') || (value[first + 1] == 'X'))) {
+        first += 2;
+    }
+    int parsed = 0;
+    const auto result = std::from_chars(value.data() + first, value.data() + end, parsed, 16);
+    if ((result.ec != std::errc{}) || (result.ptr != value.data() + end)) return false;
+    *mask = parsed;
+    return true;
+}
+
 }  // namespace OplusTouchConstants
