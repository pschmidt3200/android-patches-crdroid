diff --git a/product/packages/privileged_apps/CustomizationBundlePrebuiltFullVersion/Android.mk b/product/packages/privileged_apps/CustomizationBundlePrebuiltFullVersion/Android.mk
--- a/product/packages/privileged_apps/CustomizationBundlePrebuiltFullVersion/Android.mk
+++ b/product/packages/privileged_apps/CustomizationBundlePrebuiltFullVersion/Android.mk
@@ -19,6 +19,8 @@

 include $(CLEAR_VARS)
 LOCAL_MODULE := CustomizationBundlePrebuiltFullVersion
+LOCAL_ENFORCE_USES_LIBRARIES := false
+# The signed APK declares wear-sdk, which this crDroid tree does not provide.
 LOCAL_MODULE_TAGS := optional
 LOCAL_SRC_FILES := CustomizationBundlePrebuiltFullVersion.apk
 LOCAL_CERTIFICATE := PRESIGNED
