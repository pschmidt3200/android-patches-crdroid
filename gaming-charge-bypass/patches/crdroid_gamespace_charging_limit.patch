# Target repository: packages/apps/GameSpace
# Settings.System bypass_charge_limit: 0 = game-start level (minimum 70), otherwise 70..100 percent.
diff --git a/app/src/main/java/io/chaldeaprjkt/gamespace/settings/SettingsFragment.kt b/app/src/main/java/io/chaldeaprjkt/gamespace/settings/SettingsFragment.kt
--- a/app/src/main/java/io/chaldeaprjkt/gamespace/settings/SettingsFragment.kt
+++ b/app/src/main/java/io/chaldeaprjkt/gamespace/settings/SettingsFragment.kt
@@ -81,8 +81,13 @@
             SystemProperties.getBoolean("persist.sys.battery_bypass_supported", false)
 
         if (!isBypassSupported) {
-            findPreference<PreferenceCategory>("in_game_preferences")
-                ?.removePreference(findPreference("bypass_charge_enabled")!!)
+            val inGamePreferences = findPreference<PreferenceCategory>("in_game_preferences")
+            findPreference<Preference>("bypass_charge_limit")?.let {
+                inGamePreferences?.removePreference(it)
+            }
+            findPreference<Preference>("bypass_charge_enabled")?.let {
+                inGamePreferences?.removePreference(it)
+            }
         }
 
         if (!hasVibrator()) {
