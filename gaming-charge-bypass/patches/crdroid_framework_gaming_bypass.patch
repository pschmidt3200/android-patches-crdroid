+    private int readBypassSetting(String key) {
+        // The singleton SettingsProvider query path reads the calling user, not
+        // a user-tagged URI. LIST_SYSTEM accepts _user and retains NULL-valued
+        // rows, unlike GET_SYSTEM. Only a complete list proves choice absence.
+        Bundle args = new Bundle();
+        args.putInt(Settings.CALL_METHOD_USER_KEY, UserHandle.USER_CURRENT);
+        Bundle result = mContext.getContentResolver().call(Settings.System.CONTENT_URI,
+                Settings.CALL_METHOD_LIST_SYSTEM, null, args);
+        // SettingsProvider.RESULT_SETTINGS_LIST is a provider-side contract.
+        List<String> settings = result == null ? null
+                : result.getStringArrayList("result_settings_list");
+        if (settings == null) throw new IllegalStateException("Charging preferences unavailable");
+        String prefix = key + "=";
+        for (String setting : settings) {
+            if (setting == null) throw new IllegalStateException("Incomplete charging preferences");
+            if (setting.startsWith(prefix)) return Integer.parseInt(setting.substring(prefix.length()));
+        }
+        return 0;
+    }
