+#define LOG_TAG "bluetooth-a2dp"
+
+#include "a2dp_vendor_aptx_adaptive.h"
+
+#include <bluetooth/log.h>
+#include <string.h>
+
+#include "a2dp_vendor.h"
+#include "a2dp_vendor_aptx_adaptive_constants.h"
+#include "osi/include/properties.h"
+
+using namespace bluetooth;
+
+// Static 42-byte codec-information templates for controller offload configuration.
+// Index 0 in template corresponds to AVDTP Codec Type (0xFF = Vendor).
+static const uint8_t aptx_adaptive_r1_template[A2DP_APTX_ADAPTIVE_CODEC_LEN] = {
+        0xFF, 0xD7, 0x00, 0x00, 0x00, 0xAD, 0x00, 0x10, 0x02, 0x37, 0x6A, 0x00, 0xAF, 0x64,
+        0x4B, 0x00, 0x00, 0xAA, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+
+static const uint8_t aptx_adaptive_r2_1_template[A2DP_APTX_ADAPTIVE_CODEC_LEN] = {
+        0xFF, 0xD7, 0x00, 0x00, 0x00, 0xAD, 0x00, 0xA0, 0x02, 0x50, 0x64, 0x64, 0x64, 0xFF,
+        0xFF, 0x00, 0x01, 0x82, 0x00, 0x00, 0x0F, 0x02, 0x03, 0x03, 0x03, 0x00, 0xAA, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+
+static bool A2dpAptxAdaptiveR2_1Enabled() {
+  return osi_property_get_bool("persist.vendor.qcom.bluetooth.aptxadaptiver2_1_support", true);
+}
+
+static bool A2dpAptxAdaptiveR2_2Enabled() {
+  return osi_property_get_bool("persist.vendor.qcom.bluetooth.aptxadaptiver2_2_support", false);
+}
+
+// Joint Stereo is supported by the Bose QC Ultra 2 and FiiO BTR17 (channel mask 0x0a). Offered by
+// default since the live test on both sinks (FiiO 96 kHz and 44.1 kHz Lossless, Bose selecting 0x08
+// itself). The property only remains as an off switch for diagnosis.
+static bool A2dpAptxAdaptiveJointStereoEnabled() {
+  return osi_property_get_bool("persist.bluetooth.aptx_adaptive.offer_joint_stereo", true);
+}
+
+// Channel byte of the result element. Without the offer it stays Stereo, as before. With it, a
+// sink-selected Joint Stereo is kept, and a local selection prefers Joint Stereo when the sink
+// supports it (a sink channel value of 0x08 selects Joint Stereo).
+static uint8_t A2dpAptxAdaptiveChannelMode(const uint8_t* p_peer_codec_info, bool is_capability) {
+  const uint8_t peer_channels = p_peer_codec_info[A2DP_APTX_ADAPTIVE_SINK_CHANNEL_MODE_IDX] &
+                                A2DP_APTX_ADAPTIVE_CHANNEL_MODE_MASK;
+  if (A2dpAptxAdaptiveJointStereoEnabled() &&
+      (is_capability ? (peer_channels & A2DP_APTX_ADAPTIVE_CHANNELS_JOINT_STEREO) != 0
+                     : peer_channels == A2DP_APTX_ADAPTIVE_CHANNELS_JOINT_STEREO)) {
+    return A2DP_APTX_ADAPTIVE_CHANNELS_JOINT_STEREO;
+  }
+  return A2DP_APTX_ADAPTIVE_CHANNELS_STEREO;
+}
+
+static bool A2dpAptxAdaptivePeerSupportsR2_2(const uint8_t* p_peer_codec_info) {
+  return A2DP_IsVendorPeerSinkCodecValidAptxAdaptive(p_peer_codec_info) &&
+         p_peer_codec_info[A2DP_APTX_ADAPTIVE_SINK_CAP_EXT_VER_IDX] >=
+                 A2DP_APTX_ADAPTIVE_VERSION_R2_1 &&
+         (p_peer_codec_info[A2DP_APTX_ADAPTIVE_SINK_FEATURE_IDX] &
+          A2DP_APTX_ADAPTIVE_SINK_FEATURE_R2_2) != 0 &&
+         (p_peer_codec_info[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX] &
+          A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_44100) != 0;
+}
+
+// Feature byte of a locally selected R2.2 configuration: the selection bits of either
+// side (high nibble) and only the features both sides support (low nibble).
+static uint8_t A2dpAptxAdaptiveNegotiatedFeatureByte(uint8_t sink_features,
+                                                     uint8_t source_features) {
+  return static_cast<uint8_t>((((sink_features >> 4) | (source_features >> 4)) << 4) |
+                              (sink_features & source_features & 0x0F));
+}
+
+static btav_a2dp_codec_sample_rate_t A2dpAptxAdaptiveLocalSampleRates() {
+  uint32_t sample_rates = BTAV_A2DP_CODEC_SAMPLE_RATE_48000;
+  if (A2dpAptxAdaptiveR2_1Enabled()) {
+    sample_rates |= BTAV_A2DP_CODEC_SAMPLE_RATE_96000;
+  }
+  if (A2dpAptxAdaptiveR2_2Enabled()) {
+    sample_rates |= BTAV_A2DP_CODEC_SAMPLE_RATE_44100;
+  }
+  return static_cast<btav_a2dp_codec_sample_rate_t>(sample_rates);
+}
+
+static btav_a2dp_codec_bits_per_sample_t A2dpAptxAdaptiveLocalBitsPerSample() {
+  // The Qualcomm platform offload path expects a 24-bit PCM container even when
+  // the negotiated 44.1-kHz Lossless payload represents 16-bit CD audio.
+  return BTAV_A2DP_CODEC_BITS_PER_SAMPLE_24;
+}
+
+static constexpr uint8_t kAptxAdaptiveWireSampleRateBits =
+        A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_44100 | A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_48000 |
+        A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_96000;
+
+static uint8_t A2dpAptxAdaptiveWireSampleRateCapabilities(
+        btav_a2dp_codec_sample_rate_t sample_rates) {
+  uint8_t wire_rates = 0;
+  if (sample_rates & BTAV_A2DP_CODEC_SAMPLE_RATE_44100) {
+    wire_rates |= A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_44100;
+  }
+  if (sample_rates & BTAV_A2DP_CODEC_SAMPLE_RATE_48000) {
+    wire_rates |= A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_48000;
+  }
+  if (sample_rates & BTAV_A2DP_CODEC_SAMPLE_RATE_96000) {
+    wire_rates |= A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_96000;
+  }
+  return wire_rates;
+}
+
+A2dpCodecConfigAptxAdaptiveSource::A2dpCodecConfigAptxAdaptiveSource(
+        btav_a2dp_codec_priority_t codec_priority)
+    : A2dpCodecConfig(BTAV_A2DP_CODEC_INDEX_SOURCE_EXT_MIN, bluetooth::a2dp::CodecId::APTX_ADAPTIVE,
+                      "aptX Adaptive", codec_priority),
+      useR2_1Config(true),
+      useR2_2Config(false) {}
+
+A2dpCodecConfigAptxAdaptiveSource::~A2dpCodecConfigAptxAdaptiveSource() {}
+
+bool A2dpCodecConfigAptxAdaptiveSource::init() {
+  // aptX-Adaptive runs in hardware offload mode; no software encoder library required.
+
+  // Read Qualcomm System Properties
+  useR2_1Config = A2dpAptxAdaptiveR2_1Enabled();
+  useR2_2Config = A2dpAptxAdaptiveR2_2Enabled();
+
+  // Default capabilities
+  codec_config_.sample_rate = A2dpAptxAdaptiveLocalSampleRates();
+  codec_config_.bits_per_sample = A2dpAptxAdaptiveLocalBitsPerSample();
+  codec_config_.channel_mode = BTAV_A2DP_CODEC_CHANNEL_MODE_STEREO;
+
+  codec_local_capability_ = codec_config_;
+  // Selectable capabilities are peer-specific. Leave them empty until
+  // setCodecConfig() or setPeerCodecCapabilities() receives a valid peer element;
+  // otherwise unsupported devices would expose a selectable but silent codec.
+
+  return true;
+}
+
+tA2DP_STATUS A2dpCodecConfigAptxAdaptiveSource::setCodecConfig(const uint8_t* p_peer_codec_info,
+                                                               bool is_capability,
+                                                               uint8_t* p_result_codec_config) {
+  std::lock_guard<std::recursive_mutex> lock(codec_mutex_);
+  if (p_peer_codec_info == nullptr || p_result_codec_config == nullptr) {
+    return A2DP_FAIL;
+  }
+
+  // Verify minimum element length
+  if (p_peer_codec_info[0] < A2DP_APTX_ADAPTIVE_MIN_CAP_LEN) {
+    log::error("aptX Adaptive peer capability element too short: len={}", p_peer_codec_info[0]);
+    return A2DP_NOT_SUPPORTED_CODEC_TYPE;
+  }
+
+  uint32_t vendor_id = A2DP_VendorCodecGetVendorId(p_peer_codec_info);
+  uint16_t codec_id = A2DP_VendorCodecGetCodecId(p_peer_codec_info);
+
+  if (vendor_id != A2DP_APTX_ADAPTIVE_VENDOR_ID ||
+      (codec_id != A2DP_APTX_ADAPTIVE_CODEC_ID_BLUETOOTH && codec_id != 0x0001)) {
+    log::error("Not a valid aptX Adaptive peer codec (vendor_id=0x{:08x}, codec_id=0x{:04x})",
+               vendor_id, codec_id);
+    return A2DP_NOT_SUPPORTED_CODEC_TYPE;
+  }
+
+  uint8_t sink_cap_ext_ver_num = p_peer_codec_info[A2DP_APTX_ADAPTIVE_SINK_CAP_EXT_VER_IDX];
+  uint8_t sink_feature_byte = p_peer_codec_info[A2DP_APTX_ADAPTIVE_SINK_FEATURE_IDX];
+  uint8_t sink_rate_byte = p_peer_codec_info[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX];
+  const bool supports_r2_2 =
+          useR2_2Config && A2dpAptxAdaptivePeerSupportsR2_2(p_peer_codec_info);
+
+  log::info(
+          "aptX Adaptive: is_capability={}, sink_cap_ext_ver_num=0x{:02x}, "
+          "sink_feature_byte=0x{:02x}, sink_rate_byte=0x{:02x}",
+          is_capability, sink_cap_ext_ver_num, sink_feature_byte, sink_rate_byte);
+
+  // Compute selectable capabilities based on sink capabilities
+  codec_selectable_capability_.bits_per_sample = BTAV_A2DP_CODEC_BITS_PER_SAMPLE_24;
+  codec_selectable_capability_.channel_mode = BTAV_A2DP_CODEC_CHANNEL_MODE_STEREO;
+
+  uint8_t sample_rate_mask = BTAV_A2DP_CODEC_SAMPLE_RATE_NONE;
+  if (supports_r2_2) {
+    sample_rate_mask |= BTAV_A2DP_CODEC_SAMPLE_RATE_44100;
+  }
+  if (sink_rate_byte & A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_48000) {
+    sample_rate_mask |= BTAV_A2DP_CODEC_SAMPLE_RATE_48000;
+  }
+  if ((sink_rate_byte & A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_96000) &&
+      (sink_cap_ext_ver_num >= A2DP_APTX_ADAPTIVE_VERSION_R2_1) && useR2_1Config) {
+    sample_rate_mask |= BTAV_A2DP_CODEC_SAMPLE_RATE_96000;
+  }
+
+  if (sample_rate_mask == BTAV_A2DP_CODEC_SAMPLE_RATE_NONE) {
+    sample_rate_mask = BTAV_A2DP_CODEC_SAMPLE_RATE_48000;
+  }
+  codec_selectable_capability_.sample_rate =
+          static_cast<btav_a2dp_codec_sample_rate_t>(sample_rate_mask);
+
+  memcpy(ota_codec_peer_capability_, p_peer_codec_info, sizeof(ota_codec_peer_capability_));
+
+  // Active configuration selection
+  bool select_r1 = (sink_cap_ext_ver_num == A2DP_APTX_ADAPTIVE_VERSION_R1 || !useR2_1Config);
+
+  // Structured like the AOSP codecs (a2dp_vendor_ldac.cc, a2dp_aac.cc): a user preference first,
+  // then the codec audio config, then the best common configuration. AOSP has no aptX Adaptive,
+  // so "best" follows aptX quality: 44.1 kHz Lossless (selectable only for R2.2 sinks), then
+  // 96 kHz, then 48 kHz. Both measured sinks select Lossless themselves (FiiO 0x41/0x92, Bose
+  // 0x41/0x97); GameSpace requests low latency separately. A sink-initiated configuration carries
+  // a single rate, so the selectable mask above holds only the sink's choice.
+  btav_a2dp_codec_sample_rate_t target_sample_rate = BTAV_A2DP_CODEC_SAMPLE_RATE_48000;
+  uint8_t wire_sample_rate = A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_48000;
+
+  if (codec_user_config_.sample_rate & codec_selectable_capability_.sample_rate) {
+    target_sample_rate = static_cast<btav_a2dp_codec_sample_rate_t>(
+            codec_user_config_.sample_rate & codec_selectable_capability_.sample_rate);
+  } else if (codec_audio_config_.sample_rate & codec_selectable_capability_.sample_rate) {
+    target_sample_rate = static_cast<btav_a2dp_codec_sample_rate_t>(
+            codec_audio_config_.sample_rate & codec_selectable_capability_.sample_rate);
+  } else if (codec_selectable_capability_.sample_rate & BTAV_A2DP_CODEC_SAMPLE_RATE_44100) {
+    target_sample_rate = BTAV_A2DP_CODEC_SAMPLE_RATE_44100;
+  } else if (!select_r1 &&
+             (codec_selectable_capability_.sample_rate & BTAV_A2DP_CODEC_SAMPLE_RATE_96000)) {
+    target_sample_rate = BTAV_A2DP_CODEC_SAMPLE_RATE_96000;
+  } else if (codec_selectable_capability_.sample_rate & BTAV_A2DP_CODEC_SAMPLE_RATE_48000) {
+    target_sample_rate = BTAV_A2DP_CODEC_SAMPLE_RATE_48000;
+  } else {
+    log::error("aptX Adaptive: no mutually supported sample rate");
+    return A2DP_NOT_SUPPORTED_SAMPLING_FREQUENCY;
+  }
+
+  if (target_sample_rate == BTAV_A2DP_CODEC_SAMPLE_RATE_96000) {
+    wire_sample_rate = A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_96000;
+  } else if (target_sample_rate == BTAV_A2DP_CODEC_SAMPLE_RATE_44100) {
+    wire_sample_rate = A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_44100;
+  } else {
+    wire_sample_rate = A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_48000;
+  }
+
+  const bool select_r2_2 = supports_r2_2 &&
+                           target_sample_rate == BTAV_A2DP_CODEC_SAMPLE_RATE_44100;
+
+  // Construct complete 42-byte AVDTP Information Element with valid LOSC and Media Type headers
+  p_result_codec_config[0] = A2DP_APTX_ADAPTIVE_CODEC_LEN;  // losc = 42 (0x2A)
+  p_result_codec_config[1] = static_cast<uint8_t>(AVDT_MEDIA_TYPE_AUDIO << 4);
+
+  if (select_r1) {
+    log::info("Select Aptx Adaptive R1 config (Px8 mode)");
+    memcpy(&p_result_codec_config[2], aptx_adaptive_r1_template, A2DP_APTX_ADAPTIVE_CODEC_LEN);
+    p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX] = wire_sample_rate;
+    p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_CAP_EXT_VER_IDX] = A2DP_APTX_ADAPTIVE_VERSION_R1;
+    p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_FEATURE_IDX] = sink_feature_byte;
+  } else {
+    if (select_r2_2) {
+      log::info(
+              "Select Aptx Adaptive R2.2 / 44.1 kHz candidate config; "
+              "Lossless is not confirmed until controller and sink acknowledge it");
+    } else {
+      log::info("Select Aptx Adaptive R2.1 config");
+    }
+    memcpy(&p_result_codec_config[2], aptx_adaptive_r2_1_template, A2DP_APTX_ADAPTIVE_CODEC_LEN);
+    // The high-order extension bit is valid only for the negotiated 96-kHz profile:
+    // use 0x10 at 48 kHz and 0xA0 at 96 kHz. Applying the extension bit
+    // at 48 kHz (0x90) creates an inconsistent wire-rate value.
+    if (wire_sample_rate == A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_96000) {
+      p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX] =
+              static_cast<uint8_t>(wire_sample_rate | 0x80);
+    } else {
+      p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX] = wire_sample_rate;
+    }
+    p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_CAP_EXT_VER_IDX] =
+            A2DP_APTX_ADAPTIVE_VERSION_R2_1;
+    // For a locally selected R2.2 configuration, send the negotiated feature byte.
+    // Preserve peer-selected configurations verbatim.
+    // Measured: FiiO BTR17 caps 0x82 -> 0x92 plays LS with sound; Bose QC Ultra 2 caps 0x87
+    // selects 0x97 itself. A fixed 0x17 drops peer feature bits and does not select
+    // the same 44.1-kHz configuration on the FiiO.
+    p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_FEATURE_IDX] =
+            (select_r2_2 && is_capability)
+                    ? A2dpAptxAdaptiveNegotiatedFeatureByte(sink_feature_byte,
+                                                            A2DP_APTX_ADAPTIVE_SOURCE_FEATURE_R2_2)
+                    : sink_feature_byte;
+  }
+
+  p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_CHANNEL_MODE_IDX] =
+          A2dpAptxAdaptiveChannelMode(p_peer_codec_info, is_capability);
+  log::info("aptX Adaptive: channel mode 0x{:02x} (joint stereo offer={})",
+            p_result_codec_config[A2DP_APTX_ADAPTIVE_SINK_CHANNEL_MODE_IDX],
+            A2dpAptxAdaptiveJointStereoEnabled());
+
+  codec_config_.sample_rate = target_sample_rate;
+  codec_config_.bits_per_sample = BTAV_A2DP_CODEC_BITS_PER_SAMPLE_24;
+  codec_config_.channel_mode = BTAV_A2DP_CODEC_CHANNEL_MODE_STEREO;
+  if (useR2_2Config) {
+    codec_config_.codec_specific_3 =
+            (codec_config_.codec_specific_3 &
+             ~static_cast<int64_t>(A2DP_APTX_ADAPTIVE_R2_2_STATUS_MASK)) |
+            (supports_r2_2 ? A2DP_APTX_ADAPTIVE_R2_2_STATUS_AVAILABLE
+                           : A2DP_APTX_ADAPTIVE_R2_2_STATUS_NOT_AVAILABLE);
+  }
+
+  memcpy(ota_codec_config_, p_result_codec_config, sizeof(ota_codec_config_));
+  return A2DP_SUCCESS;
+}
+
+bool A2dpCodecConfigAptxAdaptiveSource::setPeerCodecCapabilities(
+        const uint8_t* p_peer_codec_capabilities) {
+  std::lock_guard<std::recursive_mutex> lock(codec_mutex_);
+  if (p_peer_codec_capabilities == nullptr) {
+    return false;
+  }
+
+  if (p_peer_codec_capabilities[0] < A2DP_APTX_ADAPTIVE_MIN_CAP_LEN) {
+    return false;
+  }
+
+  uint32_t vendor_id = A2DP_VendorCodecGetVendorId(p_peer_codec_capabilities);
+  uint16_t codec_id = A2DP_VendorCodecGetCodecId(p_peer_codec_capabilities);
+
+  if (vendor_id != A2DP_APTX_ADAPTIVE_VENDOR_ID ||
+      (codec_id != A2DP_APTX_ADAPTIVE_CODEC_ID_BLUETOOTH && codec_id != 0x0001)) {
+    return false;
+  }
+
+  uint8_t sink_cap_ext_ver_num = p_peer_codec_capabilities[A2DP_APTX_ADAPTIVE_SINK_CAP_EXT_VER_IDX];
+  uint8_t sink_rate_byte = p_peer_codec_capabilities[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX];
+  const bool sink_supports_r2_2 =
+          useR2_2Config && A2dpAptxAdaptivePeerSupportsR2_2(p_peer_codec_capabilities);
+
+  uint8_t sample_rate_mask = BTAV_A2DP_CODEC_SAMPLE_RATE_NONE;
+  if (sink_supports_r2_2) {
+    sample_rate_mask |= BTAV_A2DP_CODEC_SAMPLE_RATE_44100;
+  }
+  if (sink_rate_byte & A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_48000) {
+    sample_rate_mask |= BTAV_A2DP_CODEC_SAMPLE_RATE_48000;
+  }
+  if ((sink_rate_byte & A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_96000) &&
+      (sink_cap_ext_ver_num >= A2DP_APTX_ADAPTIVE_VERSION_R2_1) && useR2_1Config) {
+    sample_rate_mask |= BTAV_A2DP_CODEC_SAMPLE_RATE_96000;
+  }
+
+  if (sample_rate_mask == BTAV_A2DP_CODEC_SAMPLE_RATE_NONE) {
+    sample_rate_mask = BTAV_A2DP_CODEC_SAMPLE_RATE_48000;
+  }
+  codec_selectable_capability_.sample_rate =
+          static_cast<btav_a2dp_codec_sample_rate_t>(sample_rate_mask);
+
+  codec_selectable_capability_.bits_per_sample = BTAV_A2DP_CODEC_BITS_PER_SAMPLE_24;
+  codec_selectable_capability_.channel_mode = BTAV_A2DP_CODEC_CHANNEL_MODE_STEREO;
+
+  memcpy(ota_codec_peer_capability_, p_peer_codec_capabilities, sizeof(ota_codec_peer_capability_));
+  return true;
+}
+
+// Global C helper functions
+
+bool A2DP_IsVendorPeerSinkCodecValidAptxAdaptive(const uint8_t* p_codec_info) {
+  if (p_codec_info == nullptr) {
+    return false;
+  }
+  if (p_codec_info[0] < A2DP_APTX_ADAPTIVE_MIN_CAP_LEN) {
+    return false;
+  }
+  uint32_t vendor_id = A2DP_VendorCodecGetVendorId(p_codec_info);
+  uint16_t codec_id = A2DP_VendorCodecGetCodecId(p_codec_info);
+  return vendor_id == A2DP_APTX_ADAPTIVE_VENDOR_ID &&
+         (codec_id == A2DP_APTX_ADAPTIVE_CODEC_ID_BLUETOOTH || codec_id == 0x0001);
+}
+
+bool A2DP_IsVendorPeerSourceCodecValidAptxAdaptive(const uint8_t* p_codec_info) {
+  return A2DP_IsVendorPeerSinkCodecValidAptxAdaptive(p_codec_info);
+}
+
+// Compare fields that require stream reconfiguration. Compare the raw rate mask
+// rather than the derived track frequency because combined and single-rate masks
+// may resolve to the same highest frequency (0xB0 = 48+96 kHz and 0xA0 = 96 kHz would
+// compare equal). Bit depth is carried by the fixed
+// offload container and therefore is not part of this wire-configuration check.
+bool A2DP_VendorCodecEqualsAptxAdaptive(const uint8_t* p_codec_info_a,
+                                        const uint8_t* p_codec_info_b) {
+  // Validation also guarantees that the indexed codec fields are present.
+  if (!A2DP_IsVendorPeerSinkCodecValidAptxAdaptive(p_codec_info_a) ||
+      !A2DP_IsVendorPeerSinkCodecValidAptxAdaptive(p_codec_info_b)) {
+    return false;
+  }
+
+  uint8_t rate_a = p_codec_info_a[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX] &
+                   A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_MASK;
+  uint8_t rate_b = p_codec_info_b[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX] &
+                   A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_MASK;
+  uint8_t channel_a = p_codec_info_a[A2DP_APTX_ADAPTIVE_SINK_CHANNEL_MODE_IDX] &
+                      A2DP_APTX_ADAPTIVE_CHANNEL_MODE_MASK;
+  uint8_t channel_b = p_codec_info_b[A2DP_APTX_ADAPTIVE_SINK_CHANNEL_MODE_IDX] &
+                      A2DP_APTX_ADAPTIVE_CHANNEL_MODE_MASK;
+
+  return (rate_a == rate_b) && (channel_a == channel_b);
+}
+
+const char* A2DP_VendorCodecNameAptxAdaptive(const uint8_t* /* p_codec_info */) {
+  return "aptX Adaptive";
+}
+
+int A2DP_VendorGetTrackFrequencyAptxAdaptive(const uint8_t* p_codec_info) {
+  if (p_codec_info == nullptr) {
+    return -1;
+  }
+  uint8_t rate = p_codec_info[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX];
+  if (rate & A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_96000) {
+    return 96000;
+  }
+  if (rate & A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_48000) {
+    return 48000;
+  }
+  if (rate & A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_44100) {
+    return 44100;
+  }
+  return 48000;
+}
+
+int A2DP_VendorGetTrackChannelCountAptxAdaptive(const uint8_t* p_codec_info) {
+  if (p_codec_info == nullptr) {
+    return -1;
+  }
+  uint8_t channels = p_codec_info[A2DP_VENDOR_CODEC_START_IDX + 7];
+  if (channels & (A2DP_APTX_ADAPTIVE_CHANNELS_STEREO | A2DP_APTX_ADAPTIVE_CHANNELS_JOINT_STEREO)) {
+    return 2;
+  }
+  if (channels & A2DP_APTX_ADAPTIVE_CHANNELS_MONO) {
+    return 1;
+  }
+  return 2;
+}
+
+// The dispatcher requires this signature, but the QTI offload container is always
+// 24 bit and does not need to inspect the codec element. Lossless source material
+// may still carry 16-bit audio inside that container.
+int A2DP_VendorGetTrackBitsPerSampleAptxAdaptive(const uint8_t* /* p_codec_info */) {
+  return 24;
+}
+
+bool A2DP_VendorInitCodecConfigAptxAdaptive(AvdtpSepConfig* p_cfg) {
+  if (p_cfg == nullptr) {
+    return false;
+  }
+  log::info("aptX Adaptive driver: patch={}", APTX_VSQC_PATCH_VERSION);
+  const btav_a2dp_codec_sample_rate_t local_sample_rates = A2dpAptxAdaptiveLocalSampleRates();
+  const bool r2_2_enabled = A2dpAptxAdaptiveR2_2Enabled();
+  p_cfg->num_codec = 1;
+  p_cfg->codec_info[0] = A2DP_APTX_ADAPTIVE_CODEC_LEN;
+  p_cfg->codec_info[1] = static_cast<uint8_t>(AVDT_MEDIA_TYPE_AUDIO << 4);
+  memcpy(&p_cfg->codec_info[2], aptx_adaptive_r2_1_template, A2DP_APTX_ADAPTIVE_CODEC_LEN);
+  p_cfg->codec_info[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX] =
+          static_cast<uint8_t>(p_cfg->codec_info[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX] &
+                               ~kAptxAdaptiveWireSampleRateBits) |
+          A2dpAptxAdaptiveWireSampleRateCapabilities(local_sample_rates);
+  if (r2_2_enabled) {
+    p_cfg->codec_info[A2DP_APTX_ADAPTIVE_SINK_FEATURE_IDX] = A2DP_APTX_ADAPTIVE_SOURCE_FEATURE_R2_2;
+  }
+  if (A2dpAptxAdaptiveJointStereoEnabled()) {
+    p_cfg->codec_info[A2DP_APTX_ADAPTIVE_SINK_CHANNEL_MODE_IDX] |=
+            A2DP_APTX_ADAPTIVE_CHANNELS_JOINT_STEREO;
+  }
+  log::info("aptX Adaptive local channel modes=0x{:02x} (joint stereo offer={})",
+            p_cfg->codec_info[A2DP_APTX_ADAPTIVE_SINK_CHANNEL_MODE_IDX],
+            A2dpAptxAdaptiveJointStereoEnabled());
+  log::info("aptX Adaptive local capability: r2_2={} rates=0x{:02x} feature=0x{:02x}", r2_2_enabled,
+            p_cfg->codec_info[A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX],
+            p_cfg->codec_info[A2DP_APTX_ADAPTIVE_SINK_FEATURE_IDX]);
+  return true;
+}
