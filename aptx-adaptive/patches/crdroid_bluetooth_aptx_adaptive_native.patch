+    @VisibleForTesting
+    boolean setAptxMode(long mode, boolean overrideRuntime) {
+        try {
+            Class<?> sp = Class.forName("android.os.SystemProperties");
+            java.lang.reflect.Method setMethod = sp.getMethod("set", String.class, String.class);
+            setMethod.invoke(null, "persist.bluetooth.aptx_adaptive.mode", Long.toString(mode));
+            // The runtime property belongs to AudioFlinger. Clear it before the native
+            // UPDATE_MODE so a stale runtime value cannot override the persist value; both
+            // native readers fall back to persist when runtime is 0.
+            setMethod.invoke(null, "bluetooth.aptx_adaptive.mode.runtime", "0");
+            if (overrideRuntime) {
+                // GameSpace owns latency. Disable follow_latency so AudioFlinger's FREE
+                // signal cannot override the persistent mode.
+                setMethod.invoke(null, "persist.bluetooth.aptx_adaptive.follow_latency", "false");
+            } else {
+                // Return latency ownership to AudioFlinger.
+                setMethod.invoke(null, "persist.bluetooth.aptx_adaptive.follow_latency", "true");
