+
+    public synchronized void setGamingAudioMode(
+            BluetoothDevice device,
+            int gamingMode,
+            BluetoothCodecStatus codecStatus,
+            boolean isPlaying) {
+        if (device == null || codecStatus == null) {
+            return;
+        }
+        BluetoothCodecConfig currentConfig = codecStatus.getCodecConfig();
+        if (currentConfig == null) {
+            return;
+        }
+        if (currentConfig.getCodecType() != BluetoothCodecConfig.SOURCE_CODEC_TYPE_APTX_ADAPTIVE) {
+            Log.d(TAG, "setGamingAudioMode: not aptX Adaptive, no switch");
+            mGamingAudioTransitions.remove(device);
+            reportGamingStatus(STATUS_NO_APTX);
+            return;
+        }
+        switch (gamingMode) {
+            case GAMING_AUDIO_MODE_FORCE_LL -> enterGamingAudioMode(device, codecStatus);
+            case GAMING_AUDIO_MODE_FORCE_HQ ->
+                    startHighQualityTransition(device, codecStatus, true, STATUS_ACTIVE_HQ);
+            default -> startHighQualityTransition(device, codecStatus, false, STATUS_SYSTEM);
+        }
+    }
+
+    private void enterGamingAudioMode(
+            BluetoothDevice device, BluetoothCodecStatus codecStatus) {
+        BluetoothCodecConfig currentConfig = codecStatus.getCodecConfig();
+        int currentSampleRate = currentConfig.getSampleRate();
+        mSavedAptxAdaptiveSampleRates.putIfAbsent(device, currentSampleRate);
+        reportGamingStatus(STATUS_UNCONFIRMED);
+
+        GamingAudioTransition transition =
+                new GamingAudioTransition(
+                        STATUS_ACTIVE_LL,
+                        APTX_MODE_LL,
+                        true,
+                        currentSampleRate,
+                        codecStatus,
+                        currentSampleRate == BluetoothCodecConfig.SAMPLE_RATE_48000
+                                ? GamingAudioPhase.WAITING_FOR_MODE_ACK
+                                : GamingAudioPhase.WAITING_FOR_LL_RATE);
+        mGamingAudioTransitions.put(device, transition);
+
+        if (transition.phase == GamingAudioPhase.WAITING_FOR_LL_RATE) {
+            requestLowLatencySampleRate(device, transition);
+            return;
+        }
+        requestAptxAdaptiveMode(device, transition);
+    }
+
+    private void startHighQualityTransition(
+            BluetoothDevice device,
+            BluetoothCodecStatus codecStatus,
+            boolean overrideRuntime,
+            int requestedStatus) {
+        int currentSampleRate = codecStatus.getCodecConfig().getSampleRate();
+        int restoreSampleRate =
+                mSavedAptxAdaptiveSampleRates.getOrDefault(device, currentSampleRate);
+        reportGamingStatus(STATUS_UNCONFIRMED);
+        GamingAudioTransition transition =
+                new GamingAudioTransition(
+                        requestedStatus,
+                        APTX_MODE_HQ,
+                        overrideRuntime,
+                        restoreSampleRate,
+                        codecStatus,
+                        GamingAudioPhase.WAITING_FOR_MODE_ACK);
+        mGamingAudioTransitions.put(device, transition);
+        requestAptxAdaptiveMode(device, transition);
+    }
+
+    private void requestAptxAdaptiveMode(
+            BluetoothDevice device, GamingAudioTransition transition) {
+        if (!setAptxMode(transition.requestedMode, transition.overrideRuntime)) {
+            failGamingAudioTransition(device, "UPDATE_MODE could not be scheduled");
+        }
+    }
+
+    private boolean requestAptxAdaptiveSampleRate(
+            BluetoothDevice device, BluetoothCodecStatus codecStatus, int sampleRate) {
+        if (!isSampleRateSelectable(codecStatus, sampleRate)) {
+            Log.w(
+                    TAG,
+                    "Gaming-Audio: aptX Adaptive "
+                            + sampleRateToHz(sampleRate)
+                            + " Hz is not selectable for "
+                            + device);
+            return false;
+        }
+        BluetoothCodecConfig currentConfig = codecStatus.getCodecConfig();
+        BluetoothCodecConfig targetConfig =
+                new BluetoothCodecConfig.Builder()
+                        .setCodecType(BluetoothCodecConfig.SOURCE_CODEC_TYPE_APTX_ADAPTIVE)
+                        .setCodecPriority(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST)
+                        .setSampleRate(sampleRate)
+                        .setBitsPerSample(currentConfig.getBitsPerSample())
+                        .setChannelMode(currentConfig.getChannelMode())
+                        .setCodecSpecific1(currentConfig.getCodecSpecific1())
+                        .setCodecSpecific2(currentConfig.getCodecSpecific2())
+                        .setCodecSpecific3(currentConfig.getCodecSpecific3())
+                        .setCodecSpecific4(currentConfig.getCodecSpecific4())
+                        .build();
+        Log.i(
+                TAG,
+                "Gaming audio: requesting confirmed rate change to "
+                        + sampleRateToHz(sampleRate)
+                        + " Hz for "
+                        + device);
+        return mA2dpNativeInterface.setCodecConfigPreference(
+                device, new BluetoothCodecConfig[] {targetConfig});
+    }
+
+    /** Advances the transition after an actual codec status event. */
+    synchronized void onGamingCodecConfigUpdated(
+            BluetoothDevice device, BluetoothCodecStatus codecStatus) {
+        GamingAudioTransition transition = mGamingAudioTransitions.get(device);
+        if (transition == null || codecStatus == null || codecStatus.getCodecConfig() == null) {
+            return;
+        }
+        BluetoothCodecConfig currentConfig = codecStatus.getCodecConfig();
+        if (currentConfig.getCodecType()
+                != BluetoothCodecConfig.SOURCE_CODEC_TYPE_APTX_ADAPTIVE) {
+            mGamingAudioTransitions.remove(device);
+            reportGamingStatus(STATUS_NO_APTX);
+            return;
+        }
+        transition.codecStatus = codecStatus;
+        int currentSampleRate = currentConfig.getSampleRate();
+        if (transition.requestedMode == APTX_MODE_LL) {
+            if (currentSampleRate != BluetoothCodecConfig.SAMPLE_RATE_48000) {
+                requestLowLatencySampleRate(device, transition);
+                return;
+            }
+            if (transition.phase == GamingAudioPhase.WAITING_FOR_LL_RATE) {
+                transition.phase = GamingAudioPhase.WAITING_FOR_MODE_ACK;
+                requestAptxAdaptiveMode(device, transition);
+            }
+        } else if (transition.phase == GamingAudioPhase.WAITING_FOR_RESTORE_RATE
+                && currentSampleRate == transition.restoreSampleRate) {
+            finishGamingAudioTransition(device, transition);
+        }
+    }
+
+    /** Handles only the completion status of the controller vendor command. */
+    synchronized void onAptxAdaptiveModeResult(BluetoothDevice device, long mode, int status) {
+        GamingAudioTransition transition = mGamingAudioTransitions.get(device);
+        if (transition == null
+                || transition.phase != GamingAudioPhase.WAITING_FOR_MODE_ACK
+                || transition.requestedMode != mode) {
+            return;
+        }
+        if (status != 0) {
+            failGamingAudioTransition(
+                    device, "Controller rejected mode 0x" + Long.toHexString(mode));
+            return;
+        }
+        if (mode == APTX_MODE_LL) {
+            int currentSampleRate = transition.codecStatus.getCodecConfig().getSampleRate();
+            if (currentSampleRate != BluetoothCodecConfig.SAMPLE_RATE_48000) {
+                requestLowLatencySampleRate(device, transition);
+                return;
+            }
+            finishGamingAudioTransition(device, transition);
+            return;
+        }
+
+        int currentSampleRate = transition.codecStatus.getCodecConfig().getSampleRate();
+        if (currentSampleRate == transition.restoreSampleRate) {
+            finishGamingAudioTransition(device, transition);
+            return;
+        }
+        transition.phase = GamingAudioPhase.WAITING_FOR_RESTORE_RATE;
+        if (!requestAptxAdaptiveSampleRate(
+                device, transition.codecStatus, transition.restoreSampleRate)) {
+            failGamingAudioTransition(device, "stored rate cannot be restored");
+        }
+    }
+
+    private void requestLowLatencySampleRate(
+            BluetoothDevice device, GamingAudioTransition transition) {
+        if (transition.llRateRequestAttempts >= MAX_LL_RATE_REQUEST_ATTEMPTS) {
+            failGamingAudioTransition(device, "48 kHz not confirmed after several attempts");
+            return;
+        }
+        transition.llRateRequestAttempts++;
+        transition.phase = GamingAudioPhase.WAITING_FOR_LL_RATE;
+        if (!requestAptxAdaptiveSampleRate(
+                device, transition.codecStatus, BluetoothCodecConfig.SAMPLE_RATE_48000)) {
+            failGamingAudioTransition(device, "48 kHz cannot be requested");
+        }
+    }
+
+    private void finishGamingAudioTransition(
+            BluetoothDevice device, GamingAudioTransition transition) {
+        mGamingAudioTransitions.remove(device);
+        if (transition.requestedMode == APTX_MODE_HQ) {
+            mSavedAptxAdaptiveSampleRates.remove(device);
+        }
+        reportGamingStatus(transition.requestedStatus);
+        Log.i(
+                TAG,
+                "Gaming audio: transition confirmed for "
+                        + device
+                        + ", status="
+                        + transition.requestedStatus);
+    }
+
+    private void failGamingAudioTransition(BluetoothDevice device, String reason) {
+        mGamingAudioTransitions.remove(device);
+        reportGamingStatus(STATUS_UNCONFIRMED);
+        Log.w(TAG, "Gaming audio: transition aborted for " + device + ": " + reason);
+    }
+
+    private static boolean isSampleRateSelectable(
+            BluetoothCodecStatus codecStatus, int sampleRate) {
+        if (codecStatus == null || codecStatus.getCodecsSelectableCapabilities() == null) {
+            return false;
+        }
+        for (BluetoothCodecConfig selectable : codecStatus.getCodecsSelectableCapabilities()) {
+            if (selectable != null
+                    && selectable.getCodecType()
+                            == BluetoothCodecConfig.SOURCE_CODEC_TYPE_APTX_ADAPTIVE) {
+                if ((selectable.getSampleRate() & sampleRate) != 0) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
 }
