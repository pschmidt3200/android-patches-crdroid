+// Resolves the effective operating mode and sends it to the controller. The runtime
+// value takes precedence; 0 means unset and falls back to the persist property.
+static void vsqc_send_update_mode(const char* anlass) {
+  int32_t prop_mode = osi_property_get_int32("bluetooth.aptx_adaptive.mode.runtime", 0);
+  if (prop_mode == 0) {
+    prop_mode = osi_property_get_int32("persist.bluetooth.aptx_adaptive.mode", 0x1000);  // 4096 HQ
+  }
+  uint8_t mode_param[6] = {VSQC_SUB_OPCODE_UPDATE_MODE,
+                           0x01,
+                           0x05,
+                           0x02,
+                           static_cast<uint8_t>(prop_mode & 0xFF),
+                           static_cast<uint8_t>((prop_mode >> 8) & 0xFF)};
+  log::info("FastConnect 7900 VSQC sending UPDATE_MODE: mode=0x{:04x} ({})", prop_mode, anlass);
+  // The cast is lossless: `offload_started_hndl` is `uint16_t` upstream but only holds
+  // BTA_AV_INVALID_HANDLE (0x00) or `p_scb->hndl`, and a handle is `tBTA_AV_HNDL`
+  // (uint8_t). Without the cast, brace initialization rejects the narrowing
+  // (-Wc++11-narrowing).
+  vsqc_pending_modes.push_back(
+          {static_cast<tBTA_AV_HNDL>(bta_av_cb.offload_started_hndl),
+           static_cast<uint16_t>(prop_mode)});
+  get_btm_client_interface().vendor.BTM_VendorSpecificCommand(
+          HCI_VSQC_CONTROLLER_A2DP_OPCODE, 6, mode_param, update_mode_vendor_callback);
+}
