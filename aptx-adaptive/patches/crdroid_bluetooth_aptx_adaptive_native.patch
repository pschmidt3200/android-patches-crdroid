+  // osi_property_set returns zero on success; do not report a mode change otherwise.
+  const int result = osi_property_set(kRuntimeKey, value);
+  if (result != 0) {
+    log::warn("aptX Adaptive mode NOT set: {}={} rc={}", kRuntimeKey, value,
+              result);
+    return;
+  }
+  if (reason != nullptr) {
+    log::info("aptX Adaptive mode reset: {} ({}={})", reason, kRuntimeKey,
+              value);
+  } else {
