+void bta_av_aptx_apply_mode_now(void) {
+  if (!osi_property_get_bool("persist.bluetooth.aptx_adaptive.send_update_mode", true)) {
+    log::info("Step 2b: UPDATE_MODE is disabled by property");
+    return;
+  }
+  // Without an active offload session there is no stream to address. The START
+  // callback sends the operating mode once a stream starts.
+  if (bta_av_cb.offload_started_hndl == BTA_AV_INVALID_HANDLE) {
+    log::info("Step 2b: no active offload stream, UPDATE_MODE left to START");
+    return;
+  }
+  // Only a session started through the QTI 0xFC0A START is an aptX Adaptive controller
+  // session. SBC, AAC, LDAC, aptX and aptX HD run over AOSP 0xFD5D, where an aptX mode
+  // command addresses nothing. Gate before deduplication so no synthetic ACK is reported;
+  // the next QTI START publishes the mode and its ACK itself.
+  if (!vsqc_offload_via_qti) {
+    log::info("Step 2b: active offload session is not a QTI aptX Adaptive session, no UPDATE_MODE");
+    return;
+  }
+  int32_t prop_mode = osi_property_get_int32("bluetooth.aptx_adaptive.mode.runtime", 0);
+  if (prop_mode == 0) {
+    prop_mode = osi_property_get_int32("persist.bluetooth.aptx_adaptive.mode", 0x1000);
+  }
+  // Skip unchanged modes; AudioFlinger requests the same mode repeatedly. A queued
+  // command is the effective next state, which matters for fast LL -> HQ switches:
+  // HQ may equal the last confirmed HQ but must still follow a pending LL. Only the
+  // last queue entry describes that next state.
+  const uint16_t effective_mode = vsqc_pending_modes.empty()
+                                            ? vsqc_last_confirmed_mode
+                                            : vsqc_pending_modes.back().mode;
+  if (static_cast<uint16_t>(prop_mode) == effective_mode) {
+    log::info("Step 2b: mode unchanged (0x{:04x}), no command", prop_mode);
+    if (vsqc_pending_modes.empty()) {
+      vsqc_report_update_mode_result(bta_av_cb.offload_started_hndl,
+                                       static_cast<uint16_t>(prop_mode), 0);
+    }
+    return;
+  }
+  vsqc_send_update_mode("change during active stream");
+}
+
+static void update_mode_vendor_callback(tBTM_VSC_CMPL* param) {
+  if (vsqc_pending_modes.empty()) {
+    log::warn("FastConnect VSQC UPDATE_MODE response without a pending mode");
+    return;
+  }
+
+  const tVSQC_PENDING_MODE pending_mode = vsqc_pending_modes.front();
+  vsqc_pending_modes.pop_front();
+  const uint8_t status = (param != nullptr && param->param_len > 0) ? param->p_param_buf[0] : 0xff;
+  const uint8_t sub_opcode = (param != nullptr && param->param_len > 1) ? param->p_param_buf[1] : 0;
+
+  if (status == 0 && sub_opcode == VSQC_SUB_OPCODE_UPDATE_MODE) {
+    vsqc_last_confirmed_mode = pending_mode.mode;
+    log::info("FastConnect VSQC UPDATE_MODE accepted: mode=0x{:04x}", pending_mode.mode);
+    vsqc_report_update_mode_result(pending_mode.hndl, pending_mode.mode, 0);
+    return;
+  }
+
+  // A NACK must not block the next attempt through deduplication, so only a
+  // confirmed mode is stored.
+  log::warn("FastConnect VSQC UPDATE_MODE rejected: mode=0x{:04x} status=0x{:02x} sub=0x{:02x}",
+            pending_mode.mode, status, sub_opcode);
+  vsqc_report_update_mode_result(pending_mode.hndl, pending_mode.mode,
+                                   status == 0 ? static_cast<uint8_t>(0xfe) : status);
+}
