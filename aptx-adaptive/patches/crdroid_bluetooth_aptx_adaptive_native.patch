+ * distributed under the License is distributed on an AS IS BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef A2DP_VENDOR_APTX_ADAPTIVE_CONSTANTS_H
+#define A2DP_VENDOR_APTX_ADAPTIVE_CONSTANTS_H
+
+#include "a2dp_vendor.h"
+
+/* aptX-Adaptive codec specific settings */
+#define APTX_VSQC_PATCH_VERSION "v40-negotiated-feature-byte"
+#define A2DP_APTX_ADAPTIVE_CODEC_LEN 42
+
+#define A2DP_APTX_ADAPTIVE_VENDOR_ID 0x000000D7
+#define A2DP_APTX_ADAPTIVE_CODEC_ID_BLUETOOTH 0x00AD
+
+// Framework sample rate bitmasks
+#define A2DP_APTX_ADAPTIVE_SAMPLERATE_44100 0x01
+#define A2DP_APTX_ADAPTIVE_SAMPLERATE_48000 0x02
+#define A2DP_APTX_ADAPTIVE_SAMPLERATE_88200 0x04
+#define A2DP_APTX_ADAPTIVE_SAMPLERATE_96000 0x08
+
+// Wire sample rates (AVDTP CIE offset 9 / index 9)
+#define A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_44100 0x40
+#define A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_48000 0x10
+#define A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_96000 0x20
+#define A2DP_APTX_ADAPTIVE_WIRE_SAMPLERATE_MASK 0xF8
+
+// An R2.2 sink advertises bit 7 in its feature byte. The source feature mask 0x17
+// describes local capabilities (it includes split TX, bit 2); it must not replace
+// negotiated peer features in an active configuration. A locally selected R2.2
+// configuration carries the negotiated byte instead: high nibble = selection bits of
+// either side, low nibble = features both sides support. Measured on FiiO BTR17
+// (0x82 -> 0x92) and Bose QC Ultra 2 (0x87 -> 0x97).
+#define A2DP_APTX_ADAPTIVE_SINK_FEATURE_R2_2 0x80
+#define A2DP_APTX_ADAPTIVE_SOURCE_FEATURE_R2_2 0x17
+
+// R2.2 status reported to the framework in codec_specific_3 (bits 12-13): whether the
+// connected sink supports the R2.2 decoder. Informational; the stack does not read it.
+#define A2DP_APTX_ADAPTIVE_R2_2_STATUS_MASK 0x00003000
+#define A2DP_APTX_ADAPTIVE_R2_2_STATUS_NOT_AVAILABLE 0x00001000
+#define A2DP_APTX_ADAPTIVE_R2_2_STATUS_AVAILABLE 0x00002000
+
+// Channel mode
+#define A2DP_APTX_ADAPTIVE_CHANNELS_MONO 0x01
+#define A2DP_APTX_ADAPTIVE_CHANNELS_STEREO 0x02
+// Joint Stereo uses bit 3 of the channel-mode field and is offered by default;
+// persist.bluetooth.aptx_adaptive.offer_joint_stereo=false turns the offer off.
+#define A2DP_APTX_ADAPTIVE_CHANNELS_JOINT_STEREO 0x08
+// Only the lower six bits carry channel capabilities; upper bits are unrelated
+// to the channel-mode comparison performed by this implementation.
+#define A2DP_APTX_ADAPTIVE_CHANNEL_MODE_MASK 0x3F
+
+// CIE capability-extension versions observed on the wire. R2.2 remains version
+// 1 here and is distinguished by SINK_FEATURE_R2_2, not by a value of 2.
+#define A2DP_APTX_ADAPTIVE_VERSION_R1 0x00
+#define A2DP_APTX_ADAPTIVE_VERSION_R2_1 0x01
+
+// Offsets in full AVDTP Codec Info Element (starts after losc, media_type, codec_type)
+#define A2DP_APTX_ADAPTIVE_SINK_SAMPLE_RATE_IDX \
+  (A2DP_VENDOR_CODEC_START_IDX + 6)  // Index 9 (Wire sample rate)
+#define A2DP_APTX_ADAPTIVE_SINK_CAP_EXT_VER_IDX \
+  (A2DP_VENDOR_CODEC_START_IDX + 15)  // Index 18 (Revision)
+#define A2DP_APTX_ADAPTIVE_SINK_FEATURE_IDX \
+  (A2DP_VENDOR_CODEC_START_IDX + 16)  // Index 19 (Feature byte)
+#define A2DP_APTX_ADAPTIVE_SINK_CHANNEL_MODE_IDX \
+  (A2DP_VENDOR_CODEC_START_IDX + 7)        // Index 10 (Channel mode)
+#define A2DP_APTX_ADAPTIVE_MIN_CAP_LEN 18  // Min 18 bytes for valid losc
+#define A2DP_APTX_ADAPTIVE_CONFIG_STREAM_IDX A2DP_APTX_ADAPTIVE_SINK_CAP_EXT_VER_IDX
+#define A2DP_APTX_ADAPTIVE_CONFIG_STREAM_LEN 11
+
+// FastConnect 7900 Opcode and Sub-Opcodes
+#define HCI_VSQC_CONTROLLER_A2DP_OPCODE 0x000A
+#define VSQC_SUB_OPCODE_START 0x0A
+#define VSQC_SUB_OPCODE_STOP 0x05
+#define VSQC_SUB_OPCODE_UPDATE_MODE 0x13
+
+#endif  // A2DP_VENDOR_APTX_ADAPTIVE_CONSTANTS_H
