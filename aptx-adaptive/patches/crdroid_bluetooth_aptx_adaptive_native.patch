+// AOSP's normal latency path updates ACL latency but not the aptX Adaptive codec
+// mode. Bridge that request to the VSQC controller path through a runtime property.
+// The DSP profile remains fixed at HIGH_QUALITY; only the controller follows the
+// requested latency mode.
+static void btif_a2dp_source_aptx_mode_follows_latency(bool low_latency) {
+  static constexpr char kRuntimeKey[] = "bluetooth.aptx_adaptive.mode.runtime";
+  // Zero means no runtime override; readers then use the persistent default.
+  // An empty string is invalid because osi_property_get_int32 parses the raw value.
+  static constexpr char kUnset[] = "0";
+
+  const char* reason = nullptr;
+  if (!osi_property_get_bool("persist.bluetooth.aptx_adaptive.follow_latency", true)) {
+    // Disabling follow_latency also clears any stale runtime override.
+    reason = "abgeschaltet (follow_latency=false)";
+  } else {
+    // Publish a runtime mode only while the selected source codec uses the same
+    // extended slot consumed by the VSQC path. During codec transitions the selected
+    // codec can precede the active stream, so BTA still validates the active session.
+    // Without this gate an aptX mode was written while SBC, AAC or LDAC was active.
+    A2dpCodecConfig* codec_config = bta_av_get_a2dp_current_codec();
+    if (codec_config == nullptr) {
+      reason = "no active codec";
+    } else if (codec_config->codecIndex() != BTAV_A2DP_CODEC_INDEX_SOURCE_EXT_MIN) {
+      reason = "active codec is not aptX Adaptive";
+    }
