+     *
+     * <p>LL is requested only after 48 kHz is confirmed. The return path confirms HQ first and then
+     * restores the sample rate saved before the game started. The visible status is unconfirmed
+     * while a transition runs and is published only when the transition completes.
+     */
+    public synchronized void setGamingAudioMode(
+            BluetoothDevice device,
+            boolean isGaming,
+            BluetoothCodecStatus codecStatus,
+            boolean isPlaying) {
+        setGamingAudioMode(
+                device,
+                isGaming ? GAMING_AUDIO_MODE_FORCE_LL : GAMING_AUDIO_MODE_AUTO,
