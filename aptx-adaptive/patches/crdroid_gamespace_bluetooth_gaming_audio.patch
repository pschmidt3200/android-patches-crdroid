--- a/app/src/main/java/io/chaldeaprjkt/gamespace/settings/SettingsFragment.kt
+++ b/app/src/main/java/io/chaldeaprjkt/gamespace/settings/SettingsFragment.kt
@@ -20,6 +20,7 @@ import android.os.Build
 import android.os.Bundle
 import android.os.SystemProperties
 import android.os.Vibrator
+import android.provider.Settings
 import android.view.View
 import androidx.activity.result.contract.ActivityResultContracts
 import androidx.preference.Preference
@@ -118,11 +119,71 @@ class SettingsFragment : Hilt_SettingsFragment(),
             isChecked = gameOptimization.isCacheManagementEnabled
             onPreferenceChangeListener = this@SettingsFragment
         }
+
+        // Without this listener the summary refreshed only in onResume(): the new choice
+        // became visible only after leaving to the home screen and returning. The two
+        // switches above already have one.
+        findPreference<ListPreference>("gamespace_bluetooth_audio_mode")
+            ?.onPreferenceChangeListener = this@SettingsFragment
+
+        updateBluetoothAudioStatus()
+    }
+
+    /**
+     * Shows, next to the selected preference, what is actually active.
+     *
+     * Without this line the user sees "Low latency" even when the connected headset does
+     * not support aptX Adaptive and nothing changes on the radio link. The Bluetooth side
+     * writes the state to Settings.Secure (A2dpCodecConfig.SETTING_GAMING_AUDIO_STATUS).
+     */
+    private fun updateBluetoothAudioStatus(newSelection: String? = null) {
+        val pref = findPreference<ListPreference>("gamespace_bluetooth_audio_mode") ?: return
+
+        // In the change listener pref.value still holds the OLD value; it is stored only
+        // after we return true. Without this parameter line 1 showed the previous choice.
+        val selectedValue = newSelection ?: pref.value
+        val entryText = newSelection
+            ?.let { pref.entries?.getOrNull(pref.findIndexOfValue(it))?.toString() }
+            ?: pref.entry
+
+        val status = try {
+            Settings.Secure.getInt(
+                requireContext().contentResolver, SETTING_BT_GAMING_STATUS, -1)
+        } catch (e: Exception) {
+            -1
+        }
+        val statusText = when (status) {
+            0 -> getString(R.string.bt_gaming_status_system)
+            1 -> getString(R.string.bt_gaming_status_ll)
+            2 -> getString(R.string.bt_gaming_status_hq)
+            5 -> getString(R.string.bt_gaming_status_no_aptx)
+            // Transition pending, failed, or headset gone. Without active playback a
+            // transition stays pending until audio plays again (two of three switches in
+            // testing); the display must say so instead of staying silent.
+            STATUS_UNCONFIRMED -> getString(R.string.bt_gaming_status_unconfirmed)
+            // Never set: claim nothing, show only the preference.
+            else -> null
+        }
+
+        // The status describes the LAST session, the preference the NEXT one. Right after a
+        // change they disagree, and the Bluetooth side writes the new state only at the next
+        // game start. Showing line 2 anyway would contradict itself (for example "Low
+        // latency / High quality enforced"), so it stays hidden until the state matches.
+        //
+        // Exceptions: status 5 ("no aptX Adaptive") and STATUS_UNCONFIRMED describe the
+        // CONNECTION, not the preference. They are always shown; hiding them would remove
+        // the line exactly when it is needed.
+        val matchesSelection =
+            status == 5 || status == STATUS_UNCONFIRMED || status == selectedValue?.toIntOrNull()
+
+        pref.summary =
+            if (statusText == null || !matchesSelection) entryText else "$entryText\n$statusText"
     }
 
     override fun onResume() {
         super.onResume()
         apps?.updateAppList()
+        updateBluetoothAudioStatus()
     }
 
     override fun onDisplayPreferenceDialog(preference: Preference) {
@@ -154,7 +215,19 @@ class SettingsFragment : Hilt_SettingsFragment(),
                 gameOptimization.isCacheManagementEnabled = newValue as Boolean
                 return true
             }
+            "gamespace_bluetooth_audio_mode" -> {
+                // Use newValue, not pref.value: the latter still holds the old value here.
+                updateBluetoothAudioStatus(newValue as? String)
+                return true
+            }
         }
         return false
     }
+
+    private companion object {
+        const val SETTING_BT_GAMING_STATUS =
+            "bluetooth_aptx_adaptive_gaming_status"
+        // Mirrors A2dpCodecConfig.STATUS_UNCONFIRMED: no confirmed state.
+        const val STATUS_UNCONFIRMED = -1
+    }
 }
