+    private fun applyBluetoothGamingAudio(packageName: String) {
+        if (!appSettings.audioControlEnabled) {
+            Log.d(TAG, "Bluetooth audio control disabled (System A active) for $packageName")
+            try {
+                val currentSetting = android.provider.Settings.Secure.getInt(
+                    contentResolver,
+                    SETTING_BLUETOOTH_GAMING_AUDIO,
+                    0
+                )
+                if (currentSetting != 0) {
+                    android.provider.Settings.Secure.putInt(
+                        contentResolver,
+                        SETTING_BLUETOOTH_GAMING_AUDIO,
+                        0
+                    )
+                }
+            } catch (e: Exception) {
+                Log.e(TAG, "Failed to reset bluetooth gaming audio setting", e)
+            }
+            return
+        }
+
+        val mode = appSettings.bluetoothAudioMode // 0: Auto (Game decides), 1: Force LL, 2: Force HQ
+        val targetValue = when (mode) {
+            1 -> 1 // Force Low Latency (All games in LL mode)
+            2 -> 2 // Force High Quality (All games in HQ mode)
+            // Auto: return latency ownership to AudioFlinger, which decides from the
+            // audio flags. EXPECTATION, NOT MEASURED: deep-buffer titles stay on HQ. The
+            // first live run never reached LL because of the follow_latency collision, so
+            // the distinction was not observable. Describe it as a property only after a
+            // measurement.
+            else -> 0
+        }
+        try {
+            val currentSetting = android.provider.Settings.Secure.getInt(
+                contentResolver,
+                SETTING_BLUETOOTH_GAMING_AUDIO,
+                0
+            )
+            if (currentSetting != targetValue) {
+                android.provider.Settings.Secure.putInt(
+                    contentResolver,
+                    SETTING_BLUETOOTH_GAMING_AUDIO,
+                    targetValue
+                )
+                Log.i(TAG, "Requested bluetooth gaming audio setting=$targetValue (pref=$mode) for $packageName")
+            } else {
+                Log.d(TAG, "Bluetooth gaming audio setting already at $targetValue for $packageName")
+            }
+        } catch (e: Exception) {
+            Log.e(TAG, "Failed to apply bluetooth gaming audio mode", e)
+        }
+    }
+
+    private fun restoreBluetoothGamingAudio() {
+        try {
+            android.provider.Settings.Secure.putInt(
+                contentResolver,
+                SETTING_BLUETOOTH_GAMING_AUDIO,
+                0 // Back to standard / Hi-Res
+            )
+            Log.i(TAG, "Restored bluetooth gaming audio mode=0")
+        } catch (e: Exception) {
+            Log.e(TAG, "Failed to restore bluetooth gaming audio mode", e)
+        }
+    }
+
