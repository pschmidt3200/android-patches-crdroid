+package com.android.settings.bluetooth;
+
+import static org.junit.Assert.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import android.bluetooth.BluetoothA2dp;
+import android.bluetooth.BluetoothCodecConfig;
+import android.bluetooth.BluetoothCodecStatus;
+import android.bluetooth.BluetoothCodecType;
+import android.bluetooth.BluetoothDevice;
+import android.bluetooth.BluetoothProfile;
+import android.content.Context;
+import android.content.DialogInterface;
+
+import com.android.settingslib.bluetooth.A2dpProfile;
+import com.android.settingslib.bluetooth.CachedBluetoothDevice;
+import com.android.settingslib.bluetooth.LocalBluetoothManager;
+import com.android.settingslib.bluetooth.LocalBluetoothProfileManager;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.ArgumentCaptor;
+import org.objenesis.ObjenesisStd;
+import org.robolectric.RobolectricTestRunner;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+
+/** Actual codec models and controller methods; profile/service boundaries are mocked, no UI. */
+@RunWith(RobolectricTestRunner.class)
+public class BluetoothCodecDialogControllerTest {
+    private BluetoothCodecDialogController mController;
+    private A2dpProfile mProfile;
+    private CachedBluetoothDevice mCached;
+    private BluetoothDevice mDevice;
+    private BluetoothA2dp mService;
+    private final BluetoothCodecType mSbc = BluetoothCodecType.createFromType(0);
+    private final BluetoothCodecType mAac = BluetoothCodecType.createFromType(1);
+    private final BluetoothCodecType mVendor = new BluetoothCodecType(23, 0x10000ABCDL, "Vendor");
+    private BluetoothCodecStatus mStatus;
+    private int mNotifications;
+
+    @Before
+    public void setUp() throws Exception {
+        Context context = mock(Context.class);
+        LocalBluetoothManager manager = mock(LocalBluetoothManager.class);
+        LocalBluetoothProfileManager profiles = mock(LocalBluetoothProfileManager.class);
+        mProfile = mock(A2dpProfile.class);
+        mCached = mock(CachedBluetoothDevice.class);
+        // A genuine identity with a real equals/getAddress contract, without Binder construction.
+        mDevice = new ObjenesisStd().newInstance(BluetoothDevice.class);
+        put(mDevice, "mAddress", "00:11:22:33:44:55");
+        mService = mock(BluetoothA2dp.class);
+        when(manager.getProfileManager()).thenReturn(profiles);
+        when(profiles.getA2dpProfile()).thenReturn(mProfile);
+        when(mCached.getDevice()).thenReturn(mDevice);
+        when(mCached.getGroupId()).thenReturn(-1);
+        when(mProfile.getActiveDevice()).thenReturn(mDevice);
+        when(mProfile.isProfileReady()).thenReturn(true);
+        when(mProfile.isEnabled(mDevice)).thenReturn(true);
+        when(mProfile.getConnectionStatus(mDevice)).thenReturn(BluetoothProfile.STATE_CONNECTED);
+        when(mProfile.isHighQualityAudioEnabled(mDevice)).thenReturn(true);
+        mController = new BluetoothCodecDialogController(context, manager, true, () -> false,
+                () -> mNotifications++);
+        mController.setTarget(mCached);
+        put(mController, "mResumed", true);
+        mController.mBluetoothA2dp = mService;
+        status(mAac, List.of(cap(mSbc, 1), cap(mAac, 3), cap(mVendor, 32)));
+    }
+
+    private static void put(Object target, String name, Object value) throws Exception {
+        Field field = target.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    private static BluetoothCodecConfig cap(BluetoothCodecType type, int rateMask) {
+        return new BluetoothCodecConfig.Builder().setExtendedCodecType(type)
+                .setSampleRate(rateMask).build();
+    }
+
+    private void status(BluetoothCodecType type, List<BluetoothCodecConfig> caps) {
+        mStatus = new BluetoothCodecStatus(cap(type, BluetoothCodecConfig.SAMPLE_RATE_44100),
+                caps, caps);
+        when(mProfile.getCodecStatus(mDevice)).thenReturn(mStatus);
+    }
+
+    private void noRequest() {
+        verify(mService, never()).setCodecConfigPreference(any(), any());
+    }
+
+    @Test public void ratesOnlyForCurrentCodec() {
+        assertEquals(List.of(0, 1, 2), mController.getSelectableSampleRates(mStatus));
+        status(mVendor, List.of(cap(mSbc, 1), cap(mAac, 3), cap(mVendor, 32)));
+        assertEquals(List.of(0, 32), mController.getSelectableSampleRates(mStatus));
+    }
+
+    @Test public void duplicateCapabilitiesMergeAllSixRates() {
+        status(mAac, List.of(cap(mSbc, 1), cap(mAac, 15), cap(mAac, 48)));
+        assertEquals(List.of(0, 1, 2, 4, 8, 16, 32), mController.getSelectableSampleRates(mStatus));
+    }
+
+    @Test public void disabledCapabilitiesDoNotContributeRates() {
+        BluetoothCodecConfig disabled = new BluetoothCodecConfig.Builder().setExtendedCodecType(mAac)
+                .setSampleRate(32).setCodecPriority(BluetoothCodecConfig.CODEC_PRIORITY_DISABLED)
+                .build();
+        status(mAac, Arrays.asList(cap(mSbc, 1), cap(mAac, 3), disabled, null));
+        assertEquals(List.of(0, 1, 2), mController.getSelectableSampleRates(mStatus));
+    }
+
+    @Test public void missingMandatoryCodecBlocksRates() {
+        status(mAac, List.of(cap(mAac, 3)));
+        assertTrue(mController.getSelectableSampleRates(mStatus).isEmpty());
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        noRequest();
+    }
+
+    @Test public void hdPolicyBlocksOptionalCodecRates() {
+        when(mProfile.isHighQualityAudioEnabled(mDevice)).thenReturn(false);
+        assertTrue(mController.getSelectableSampleRates(mStatus).isEmpty());
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        status(mSbc, List.of(cap(mSbc, 1), cap(mAac, 3)));
+        assertEquals(List.of(0, 1), mController.getSelectableSampleRates(mStatus));
+        noRequest();
+    }
+
+    @Test public void explicitRateUsesSameCodecAndAutoOtherFields() {
+        assertTrue(mController.requestSampleRate(mAac, 2));
+        ArgumentCaptor<BluetoothCodecConfig> request = ArgumentCaptor.forClass(BluetoothCodecConfig.class);
+        verify(mService).setCodecConfigPreference(eq(mDevice), request.capture());
+        assertEquals(mAac, request.getValue().getExtendedCodecType());
+        assertEquals(2, request.getValue().getSampleRate());
+        assertEquals(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST, request.getValue().getCodecPriority());
+        assertEquals(0, request.getValue().getBitsPerSample());
+        assertEquals(0, request.getValue().getChannelMode());
+        assertEquals(0L, request.getValue().getCodecSpecific1());
+        assertEquals(1, mNotifications);
+        assertEquals(1, mStatus.getCodecConfig().getSampleRate()); // No optimistic status mutation.
+    }
+
+    @Test public void automaticSendsNone() {
+        assertTrue(mController.requestSampleRate(mAac, 0));
+        ArgumentCaptor<BluetoothCodecConfig> request = ArgumentCaptor.forClass(BluetoothCodecConfig.class);
+        verify(mService).setCodecConfigPreference(eq(mDevice), request.capture());
+        assertEquals(BluetoothCodecConfig.SAMPLE_RATE_NONE, request.getValue().getSampleRate());
+    }
+
+    @Test public void unsupportedRateOrMaskNeverSubmitted() {
+        assertFalse(mController.requestSampleRate(mAac, 32));
+        assertFalse(mController.requestSampleRate(mAac, 3));
+        noRequest();
+    }
+
+    @Test public void freshCapabilitiesOverrideOpenedList() {
+        assertEquals(List.of(0, 1, 2), mController.getSelectableSampleRates(mStatus));
+        status(mAac, List.of(cap(mSbc, 1), cap(mAac, 1)));
+        assertFalse(mController.requestSampleRate(mAac, 2));
+        noRequest();
+    }
+
+    @Test public void changedCodecBlocksOldSelection() {
+        status(mSbc, List.of(cap(mSbc, 1), cap(mAac, 3)));
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        noRequest();
+    }
+
+    @Test public void disconnectedOrBusyNeverSubmitted() {
+        when(mProfile.getConnectionStatus(mDevice)).thenReturn(BluetoothProfile.STATE_DISCONNECTED);
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        when(mProfile.getConnectionStatus(mDevice)).thenReturn(BluetoothProfile.STATE_CONNECTED);
+        when(mCached.isBusy()).thenReturn(true);
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        noRequest();
+    }
+
+    @Test public void inactiveTargetOrActiveLeNeverSubmitted() throws Exception {
+        BluetoothDevice other = new ObjenesisStd().newInstance(BluetoothDevice.class);
+        put(other, "mAddress", "00:11:22:33:44:66");
+        when(mProfile.getActiveDevice()).thenReturn(other);
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        when(mProfile.getActiveDevice()).thenReturn(mDevice);
+        when(mCached.isActiveDevice(BluetoothProfile.LE_AUDIO)).thenReturn(true);
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        noRequest();
+    }
+
+    @Test public void pausedOrNoProxyNeverSubmitted() throws Exception {
+        put(mController, "mResumed", false);
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        put(mController, "mResumed", true);
+        mController.mBluetoothA2dp = null;
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        noRequest();
+    }
+
+    private void clickRate(int generation, CachedBluetoothDevice target, int index) throws Exception {
+        Method click = Arrays.stream(BluetoothCodecDialogController.class.getDeclaredMethods())
+                .filter(method -> method.getName().startsWith("lambda$showSampleRateDialog$")
+                        && Arrays.asList(method.getParameterTypes()).contains(DialogInterface.class)
+                        && Arrays.asList(method.getParameterTypes()).contains(List.class))
+                .findFirst().orElseThrow();
+        click.setAccessible(true);
+        Object[] arguments = new Object[click.getParameterCount()];
+        int integerCount = 0;
+        for (int i = 0; i < arguments.length; i++) {
+            Class<?> type = click.getParameterTypes()[i];
+            if (type == List.class) arguments[i] = List.of(0, 1, 2);
+            else if (type == BluetoothCodecType.class) arguments[i] = mAac;
+            else if (type == CachedBluetoothDevice.class) arguments[i] = target;
+            else if (type == int.class) arguments[i] = integerCount++ == 0 ? generation : index;
+            else assertEquals(DialogInterface.class, type);
+        }
+        assertEquals(2, integerCount);
+        click.invoke(mController, arguments);
+    }
+
+    @Test public void currentDialogGenerationSubmits() throws Exception {
+        Field generation = BluetoothCodecDialogController.class.getDeclaredField("mGeneration");
+        generation.setAccessible(true);
+        clickRate(generation.getInt(mController), mCached, 2);
+        ArgumentCaptor<BluetoothCodecConfig> request = ArgumentCaptor.forClass(BluetoothCodecConfig.class);
+        verify(mService).setCodecConfigPreference(eq(mDevice), request.capture());
+        assertEquals(2, request.getValue().getSampleRate());
+    }
+
+    @Test public void staleDialogGenerationDoesNotSubmit() throws Exception {
+        clickRate(-1, mCached, 1);
+        noRequest();
+    }
+
+    @Test public void differentTargetWithCurrentGenerationDoesNotSubmit() throws Exception {
+        Field generation = BluetoothCodecDialogController.class.getDeclaredField("mGeneration");
+        generation.setAccessible(true);
+        clickRate(generation.getInt(mController), mock(CachedBluetoothDevice.class), 1);
+        noRequest();
+    }
+
+    @Test public void nullStatusOrCurrentConfigOffersNoRates() {
+        assertTrue(mController.getSelectableSampleRates(null).isEmpty());
+        assertTrue(mController.getSelectableSampleRates(
+                new BluetoothCodecStatus(null, List.of(), List.of())).isEmpty());
+        when(mProfile.getCodecStatus(mDevice)).thenReturn(null);
+        assertFalse(mController.requestSampleRate(mAac, 1));
+        noRequest();
+    }
+}
