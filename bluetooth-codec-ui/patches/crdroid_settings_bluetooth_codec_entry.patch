+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.bluetooth;
+
+import android.app.AlertDialog;
+import android.bluetooth.BluetoothA2dp;
+import android.bluetooth.BluetoothAdapter;
+import android.bluetooth.BluetoothCodecConfig;
+import android.bluetooth.BluetoothCodecStatus;
+import android.bluetooth.BluetoothCodecType;
+import android.bluetooth.BluetoothDevice;
+import android.bluetooth.BluetoothManager;
+import android.bluetooth.BluetoothProfile;
+import android.content.Context;
+import android.util.Log;
+import android.widget.TextView;
+
+import androidx.annotation.VisibleForTesting;
+
+import com.android.settings.R;
+import com.android.settingslib.bluetooth.A2dpProfile;
+import com.android.settingslib.bluetooth.CachedBluetoothDevice;
+import com.android.settingslib.bluetooth.LocalBluetoothManager;
+
+import java.text.NumberFormat;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.BooleanSupplier;
+
+/** Shared codec status, dialog and A2DP proxy lifecycle for Settings entry points. */
+public final class BluetoothCodecDialogController implements CachedBluetoothDevice.Callback {
+    private static final String TAG = "BluetoothCodecDialog";
+    private final Context mContext;
+    private final LocalBluetoothManager mManager;
+    private final boolean mRequireActiveTarget;
+    private final BooleanSupplier mIsBlocked;
+    private final Runnable mOnStateChanged;
+    private CachedBluetoothDevice mTarget;
+    private Set<CachedBluetoothDevice> mRegisteredDevices = Collections.emptySet();
+    private boolean mResumed;
+    private int mGeneration;
+    private BluetoothA2dp mOwnedA2dpProxy;
+    private AlertDialog mDialog;
+    private List<BluetoothCodecType> mDialogTypes = Collections.emptyList();
+    private List<Integer> mDialogRates = Collections.emptyList();
+    private BluetoothCodecType mDialogRateCodec;
+    @VisibleForTesting BluetoothAdapter mBluetoothAdapter;
+    @VisibleForTesting BluetoothA2dp mBluetoothA2dp;
+    @VisibleForTesting BluetoothProfile.ServiceListener mA2dpServiceListener;
+
+    public BluetoothCodecDialogController(Context context, LocalBluetoothManager manager,
+            boolean requireActiveTarget, BooleanSupplier isBlocked, Runnable onStateChanged) {
+        mContext = context;
+        mManager = manager;
+        mRequireActiveTarget = requireActiveTarget;
+        mIsBlocked = isBlocked;
+        mOnStateChanged = onStateChanged;
+        BluetoothManager bluetoothManager = context.getSystemService(BluetoothManager.class);
+        mBluetoothAdapter = bluetoothManager == null ? null : bluetoothManager.getAdapter();
+    }
+
+    /** Changing the target invalidates old dialogs and pending service callbacks. */
+    public void setTarget(CachedBluetoothDevice target) {
+        if (Objects.equals(mTarget, target)) {
+            return;
+        }
+        mGeneration++;
+        unregisterDeviceCallbacks();
+        dismissDialog();
+        closeProxy();
+        mTarget = target;
+        if (mResumed) {
+            registerDeviceCallbacks();
+            requestProxy();
+        }
+    }
+
+    public void onResume() {
+        if (mResumed) return;
+        mResumed = true;
+        registerDeviceCallbacks();
+        requestProxy();
+        refresh();
+    }
+
+    public void onPause() {
+        mResumed = false;
+        mGeneration++;
+        unregisterDeviceCallbacks();
+        dismissDialog();
+        closeProxy();
+    }
+
+    private Set<CachedBluetoothDevice> getDeviceGroup() {
+        return mTarget == null || mManager == null ? Collections.emptySet()
+                : Utils.findAllCachedBluetoothDevicesByGroupId(mManager, mTarget);
+    }
+
+    private void registerDeviceCallbacks() {
+        Set<CachedBluetoothDevice> group = getDeviceGroup();
+        if (group.equals(mRegisteredDevices)) return;
+        unregisterDeviceCallbacks();
+        mRegisteredDevices = group;
+        for (CachedBluetoothDevice device : group) {
+            device.registerCallback(mContext.getMainExecutor(), this);
+        }
+    }
+
+    private void unregisterDeviceCallbacks() {
+        for (CachedBluetoothDevice device : mRegisteredDevices) device.unregisterCallback(this);
+        mRegisteredDevices = Collections.emptySet();
+    }
+
+    @Override
+    public void onDeviceAttributesChanged() {
+        refresh();
+        mOnStateChanged.run();
+    }
+
+    private A2dpProfile getProfile() {
+        return mManager == null ? null : mManager.getProfileManager().getA2dpProfile();
+    }
+
+    private BluetoothCodecStatus getCodecStatus() {
+        A2dpProfile profile = getProfile();
+        if (mTarget == null || profile == null || !profile.isProfileReady() || mIsBlocked.getAsBoolean()) {
+            return null;
+        }
+        BluetoothDevice device = mTarget.getDevice();
+        Set<CachedBluetoothDevice> group = getDeviceGroup();
+        if (!profile.isEnabled(device)
+                || profile.getConnectionStatus(device) != BluetoothProfile.STATE_CONNECTED
+                || mTarget.isBusy() || group.stream().anyMatch(CachedBluetoothDevice::isBusy)) {
+            return null;
+        }
+        if (mRequireActiveTarget && (!device.equals(profile.getActiveDevice())
+                || group.stream().anyMatch(item -> item.isActiveDevice(BluetoothProfile.LE_AUDIO)))) {
+            return null;
+        }
+        return profile.getCodecStatus(device);
+    }
+
+    private List<BluetoothCodecType> getSelectableCodecTypes(BluetoothCodecStatus status) {
+        List<BluetoothCodecType> result = new ArrayList<>();
+        if (status == null || status.getCodecConfig() == null
+                || status.getCodecConfig().getExtendedCodecType() == null) return result;
+        List<BluetoothCodecConfig> capabilities = new ArrayList<>(status.getCodecsSelectableCapabilities());
+        capabilities.removeIf(config -> config == null || config.getExtendedCodecType() == null
+                || config.getCodecPriority() == BluetoothCodecConfig.CODEC_PRIORITY_DISABLED);
+        capabilities.sort(Comparator.comparingInt(BluetoothCodecConfig::getCodecPriority)
+                .reversed().thenComparingLong(config -> config.getExtendedCodecType().getCodecId()));
+        // The service rejects requests until mandatory SBC is known selectable.
+        if (capabilities.stream().noneMatch(BluetoothCodecConfig::isMandatoryCodec)) return result;
+        boolean hdEnabled = getProfile().isHighQualityAudioEnabled(mTarget.getDevice());
+        for (BluetoothCodecConfig config : capabilities) {
+            if (!hdEnabled && !config.isMandatoryCodec()) continue;
+            BluetoothCodecType type = config.getExtendedCodecType();
+            if (!result.contains(type)) result.add(type);
+        }
+        return result;
+    }
+
+    public boolean canShowDialog() {
+        return mResumed && mBluetoothA2dp != null
+                && !getSelectableCodecTypes(getCodecStatus()).isEmpty();
+    }
+
+    public CharSequence getSummary() {
+        BluetoothCodecStatus status = getCodecStatus();
+        BluetoothCodecConfig current = status == null ? null : status.getCodecConfig();
+        if (current == null || current.getExtendedCodecType() == null) {
+            return mContext.getString(R.string.bluetooth_codec_menu_unavailable);
+        }
+        String name = current.getExtendedCodecType().getCodecName();
+        int rateHz = getSampleRateHz(current.getSampleRate());
+        // NONE and capability bitmasks do not establish an actual sample rate.
+        return rateHz == 0 ? name : mContext.getString(R.string.bluetooth_codec_menu_current,
+                name, formatSampleRate(rateHz));
+    }
+
+    private static int getSampleRateHz(int sampleRate) {
+        return switch (sampleRate) {
+            case BluetoothCodecConfig.SAMPLE_RATE_44100 -> 44100;
+            case BluetoothCodecConfig.SAMPLE_RATE_48000 -> 48000;
+            case BluetoothCodecConfig.SAMPLE_RATE_88200 -> 88200;
+            case BluetoothCodecConfig.SAMPLE_RATE_96000 -> 96000;
+            case BluetoothCodecConfig.SAMPLE_RATE_176400 -> 176400;
+            case BluetoothCodecConfig.SAMPLE_RATE_192000 -> 192000;
+            default -> 0;
+        };
+    }
+
+    private String formatSampleRate(int rateHz) {
+        // Hz to kHz; fractional rates retain the locale's decimal separator.
+        return NumberFormat.getNumberInstance(
+                mContext.getResources().getConfiguration().getLocales().get(0))
+                .format(rateHz / 1000.0);
+    }
+
+    @VisibleForTesting
+    List<Integer> getSelectableSampleRates(BluetoothCodecStatus status) {
+        if (status == null || status.getCodecConfig() == null) return Collections.emptyList();
+        BluetoothCodecType type = status.getCodecConfig().getExtendedCodecType();
+        if (!getSelectableCodecTypes(status).contains(type)) return Collections.emptyList();
+        int supportedRates = 0;
+        for (BluetoothCodecConfig config : status.getCodecsSelectableCapabilities()) {
+            if (config != null && type.equals(config.getExtendedCodecType())
+                    && config.getCodecPriority() != BluetoothCodecConfig.CODEC_PRIORITY_DISABLED) {
+                supportedRates |= config.getSampleRate();
+            }
+        }
+        List<Integer> rates = new ArrayList<>();
+        for (int rate : new int[] {BluetoothCodecConfig.SAMPLE_RATE_NONE,
+                BluetoothCodecConfig.SAMPLE_RATE_44100, BluetoothCodecConfig.SAMPLE_RATE_48000,
+                BluetoothCodecConfig.SAMPLE_RATE_88200, BluetoothCodecConfig.SAMPLE_RATE_96000,
+                BluetoothCodecConfig.SAMPLE_RATE_176400, BluetoothCodecConfig.SAMPLE_RATE_192000}) {
+            if ((rate == BluetoothCodecConfig.SAMPLE_RATE_NONE || (supportedRates & rate) != 0)
+                    && status.isCodecConfigSelectable(new BluetoothCodecConfig.Builder()
+                            .setExtendedCodecType(type).setSampleRate(rate).build())) {
+                rates.add(rate);
+            }
+        }
+        return rates;
+    }
+
+    @VisibleForTesting
+    boolean requestSampleRate(BluetoothCodecType type, int sampleRate) {
+        if (!mResumed || mBluetoothA2dp == null) return false;
+        BluetoothCodecStatus freshStatus = getCodecStatus();
+        if (freshStatus == null || freshStatus.getCodecConfig() == null
+                || !type.equals(freshStatus.getCodecConfig().getExtendedCodecType())
+                || !getSelectableSampleRates(freshStatus).contains(sampleRate)) return false;
+        BluetoothCodecConfig request = new BluetoothCodecConfig.Builder()
+                .setExtendedCodecType(type)
+                .setCodecPriority(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST)
+                .setSampleRate(sampleRate).build();
+        if (!freshStatus.isCodecConfigSelectable(request)) return false;
+        try {
+            mBluetoothA2dp.setCodecConfigPreference(mTarget.getDevice(), request);
+        } catch (IllegalArgumentException | SecurityException e) {
+            Log.w(TAG, "Sample rate request rejected", e);
+            return false;
+        }
+        // Submission is not readback. Only the codec broadcast supplies the actual rate.
+        refresh();
+        mOnStateChanged.run();
+        return true;
+    }
+
+    public void showDialog() {
+        dismissDialog();
+        if (!canShowDialog()) return;
+        BluetoothCodecStatus status = getCodecStatus();
+        List<BluetoothCodecType> types = getSelectableCodecTypes(status);
+        if (types.isEmpty()) return;
+        final CachedBluetoothDevice target = mTarget;
+        final int generation = mGeneration;
+        CharSequence[] labels = types.stream().map(BluetoothCodecType::getCodecName)
+                .toArray(CharSequence[]::new);
+        int selected = types.indexOf(status.getCodecConfig().getExtendedCodecType());
+        TextView hint = new TextView(mContext);
+        hint.setText(R.string.bluetooth_codec_menu_connection_hint);
+        AlertDialog dialog = new AlertDialog.Builder(mContext)
+                .setTitle(R.string.bluetooth_codec_menu_title)
+                .setSingleChoiceItems(labels, selected, (ignored, index) -> {
+                    dismissDialog();
+                    if (index < 0 || index >= types.size() || !mResumed || mBluetoothA2dp == null
+                            || generation != mGeneration || !Objects.equals(target, mTarget)) return;
+                    BluetoothCodecType type = types.get(index);
+                    BluetoothCodecStatus freshStatus = getCodecStatus();
+                    if (getSelectableCodecTypes(freshStatus).contains(type)) {
+                        BluetoothCodecConfig request = new BluetoothCodecConfig.Builder()
+                                .setExtendedCodecType(type)
+                                .setCodecPriority(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST)
+                                .build();
+                        // Request only the type; rates and codec-specific fields remain AUTO.
+                        if (freshStatus.isCodecConfigSelectable(request)) {
+                            try {
+                                mBluetoothA2dp.setCodecConfigPreference(target.getDevice(), request);
+                            } catch (IllegalArgumentException | SecurityException e) {
+                                Log.w(TAG, "Codec request rejected", e);
+                            }
+                        }
+                    }
+                    // The setter returns void. The live codec status supplies every summary.
+                    refresh();
+                    mOnStateChanged.run();
+                })
+                .setView(hint)
+                .setNeutralButton(R.string.bluetooth_codec_sample_rate_title,
+                        (ignored, which) -> showSampleRateDialog())
+                .setNegativeButton(android.R.string.cancel, null)
+                .create();
+        mDialog = dialog;
+        mDialogTypes = List.copyOf(types);
+        dialog.setOnDismissListener(ignored -> {
+            if (mDialog == dialog) {
+                mDialog = null;
+                mDialogTypes = Collections.emptyList();
+            }
+        });
+        dialog.show();
+        dialog.getButton(AlertDialog.BUTTON_NEUTRAL)
+                .setEnabled(!getSelectableSampleRates(status).isEmpty());
+    }
+
+    public void showSampleRateDialog() {
+        dismissDialog();
+        if (!canShowDialog()) return;
+        BluetoothCodecStatus status = getCodecStatus();
+        List<Integer> rates = getSelectableSampleRates(status);
+        if (rates.isEmpty()) return;
+        final BluetoothCodecType type = status.getCodecConfig().getExtendedCodecType();
+        final CachedBluetoothDevice target = mTarget;
+        final int generation = mGeneration;
+        CharSequence[] labels = rates.stream().map(rate ->
+                rate == BluetoothCodecConfig.SAMPLE_RATE_NONE
+                        ? mContext.getString(R.string.bluetooth_codec_sample_rate_auto)
+                        : mContext.getString(R.string.bluetooth_codec_sample_rate_value,
+                                formatSampleRate(getSampleRateHz(rate))))
+                .toArray(CharSequence[]::new);
+        AlertDialog dialog = new AlertDialog.Builder(mContext)
+                .setTitle(R.string.bluetooth_codec_sample_rate_title)
+                .setSingleChoiceItems(labels, rates.indexOf(status.getCodecConfig().getSampleRate()),
+                        (ignored, index) -> {
+                            dismissDialog();
+                            if (index >= 0 && index < rates.size() && generation == mGeneration
+                                    && Objects.equals(target, mTarget)) {
+                                requestSampleRate(type, rates.get(index));
+                            }
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .create();
+        mDialog = dialog;
+        mDialogRates = List.copyOf(rates);
+        mDialogRateCodec = type;
+        dialog.setOnDismissListener(ignored -> {
+            if (mDialog == dialog) {
+                mDialog = null;
+                mDialogRates = Collections.emptyList();
+                mDialogRateCodec = null;
+            }
+        });
+        dialog.show();
+    }
+
+    public void refresh() {
+        if (mResumed) registerDeviceCallbacks();
+        if (mDialog == null) return;
+        BluetoothCodecStatus status = getCodecStatus();
+        if (mDialogRateCodec != null) {
+            if (!mResumed || mBluetoothA2dp == null || status == null
+                    || status.getCodecConfig() == null
+                    || !mDialogRateCodec.equals(status.getCodecConfig().getExtendedCodecType())
+                    || !getSelectableSampleRates(status).equals(mDialogRates)) {
+                dismissDialog();
+            } else {
+                int selected = mDialogRates.indexOf(status.getCodecConfig().getSampleRate());
+                mDialog.getListView().clearChoices();
+                if (selected >= 0) mDialog.getListView().setItemChecked(selected, true);
+            }
+            return;
+        }
+        if (!mResumed || mBluetoothA2dp == null
+                || !getSelectableCodecTypes(status).equals(mDialogTypes)) {
+            dismissDialog();
+        } else {
+            int selected = mDialogTypes.indexOf(status.getCodecConfig().getExtendedCodecType());
+            mDialog.getListView().clearChoices();
+            if (selected >= 0) mDialog.getListView().setItemChecked(selected, true);
+        }
+    }
+
+    private void dismissDialog() {
+        if (mDialog == null) return;
+        AlertDialog dialog = mDialog;
+        mDialog = null;
+        mDialogTypes = Collections.emptyList();
+        mDialogRates = Collections.emptyList();
+        mDialogRateCodec = null;
+        dialog.dismiss();
+    }
+
+    private void requestProxy() {
+        if (!mResumed || mTarget == null || mBluetoothAdapter == null || mOwnedA2dpProxy != null) return;
+        final int generation = ++mGeneration;
+        mA2dpServiceListener = new BluetoothProfile.ServiceListener() {
+            @Override
+            public void onServiceConnected(int profile, BluetoothProfile proxy) {
+                if (profile != BluetoothProfile.A2DP || !(proxy instanceof BluetoothA2dp)) return;
+                if (!mResumed || generation != mGeneration) {
+                    mBluetoothAdapter.closeProfileProxy(BluetoothProfile.A2DP, proxy);
+                    return;
+                }
+                if (mOwnedA2dpProxy != proxy) closeProxy();
+                mOwnedA2dpProxy = (BluetoothA2dp) proxy;
+                mBluetoothA2dp = (BluetoothA2dp) proxy;
+                refresh();
+                mOnStateChanged.run();
+            }
+
+            @Override
+            public void onServiceDisconnected(int profile) {
+                if (profile == BluetoothProfile.A2DP && generation == mGeneration) {
+                    dismissDialog();
+                    mBluetoothA2dp = null;
+                    mOnStateChanged.run();
+                }
+            }
+        };
+        mBluetoothAdapter.getProfileProxy(mContext, mA2dpServiceListener, BluetoothProfile.A2DP);
+    }
+
+    private void closeProxy() {
+        BluetoothA2dp proxy = mOwnedA2dpProxy;
+        mOwnedA2dpProxy = null;
+        mBluetoothA2dp = null;
+        if (proxy != null && mBluetoothAdapter != null) {
+            mBluetoothAdapter.closeProfileProxy(BluetoothProfile.A2DP, proxy);
+        }
+    }
+}
