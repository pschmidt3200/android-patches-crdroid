diff --git a/src/com/android/settings/bluetooth/BluetoothCodecDialogController.java b/src/com/android/settings/bluetooth/BluetoothCodecDialogController.java
new file mode 100644
index 00000000000..689170129f6
--- /dev/null
+++ b/src/com/android/settings/bluetooth/BluetoothCodecDialogController.java
@@ -0,0 +1,904 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.bluetooth;
+
+import android.app.AlertDialog;
+import android.bluetooth.BluetoothA2dp;
+import android.bluetooth.BluetoothAdapter;
+import android.bluetooth.BluetoothCodecConfig;
+import android.bluetooth.BluetoothCodecStatus;
+import android.bluetooth.BluetoothCodecType;
+import android.bluetooth.BluetoothDevice;
+import android.bluetooth.BluetoothLeAudio;
+import android.bluetooth.BluetoothLeAudioCodecConfig;
+import android.bluetooth.BluetoothLeAudioCodecStatus;
+import android.bluetooth.BluetoothManager;
+import android.bluetooth.BluetoothProfile;
+import android.content.Context;
+import android.util.Log;
+import android.util.TypedValue;
+import android.widget.TextView;
+
+import androidx.annotation.VisibleForTesting;
+
+import com.android.settings.R;
+import com.android.settingslib.bluetooth.A2dpProfile;
+import com.android.settingslib.bluetooth.CachedBluetoothDevice;
+import com.android.settingslib.bluetooth.LocalBluetoothManager;
+
+import java.text.NumberFormat;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.BooleanSupplier;
+
+/** Shared A2DP/LE status and dialogs, with separately owned profile proxies. */
+public final class BluetoothCodecDialogController implements CachedBluetoothDevice.Callback {
+    private static final String TAG = "BluetoothCodecDialog";
+    private final Context mContext;
+    private final LocalBluetoothManager mManager;
+    private final boolean mRequireActiveTarget;
+    private final BooleanSupplier mIsBlocked;
+    private final Runnable mOnStateChanged;
+    private CachedBluetoothDevice mTarget;
+    private Set<CachedBluetoothDevice> mRegisteredDevices = Collections.emptySet();
+    private boolean mResumed;
+    private int mGeneration;
+    private BluetoothA2dp mOwnedA2dpProxy;
+    private AlertDialog mDialog;
+    private List<BluetoothCodecType> mDialogTypes = Collections.emptyList();
+    private List<Integer> mDialogRates = Collections.emptyList();
+    private BluetoothCodecType mDialogRateCodec;
+    private BluetoothLeAudio mOwnedLeProxy;
+    private BluetoothLeAudio mBluetoothLeAudio;
+    private BluetoothLeAudio.Callback mLeCallback;
+    private boolean mLeProxyPending;
+    private AlertDialog mLeDialog;
+    private int mLeDialogGroupId = -1;
+    private int mLeDialogCodecType;
+    private LeParameter mLeDialogParameter;
+    private List<BluetoothLeAudioCodecConfig> mLeDialogOptions = Collections.emptyList();
+    @VisibleForTesting BluetoothAdapter mBluetoothAdapter;
+    @VisibleForTesting BluetoothA2dp mBluetoothA2dp;
+    @VisibleForTesting BluetoothProfile.ServiceListener mA2dpServiceListener;
+
+    public BluetoothCodecDialogController(Context context, LocalBluetoothManager manager,
+            boolean requireActiveTarget, BooleanSupplier isBlocked, Runnable onStateChanged) {
+        mContext = context;
+        mManager = manager;
+        mRequireActiveTarget = requireActiveTarget;
+        mIsBlocked = isBlocked;
+        mOnStateChanged = onStateChanged;
+        BluetoothManager bluetoothManager = context.getSystemService(BluetoothManager.class);
+        mBluetoothAdapter = bluetoothManager == null ? null : bluetoothManager.getAdapter();
+    }
+
+    /** Changing the target invalidates old dialogs and pending service callbacks. */
+    public void setTarget(CachedBluetoothDevice target) {
+        if (Objects.equals(mTarget, target)) {
+            return;
+        }
+        mGeneration++;
+        unregisterDeviceCallbacks();
+        dismissDialog();
+        closeProxy();
+        closeLeProxy();
+        mTarget = target;
+        if (mResumed) {
+            registerDeviceCallbacks();
+            requestProxy();
+            requestLeProxy();
+        }
+    }
+
+    public void onResume() {
+        if (mResumed) return;
+        mResumed = true;
+        registerDeviceCallbacks();
+        requestProxy();
+        requestLeProxy();
+        refresh();
+    }
+
+    public void onPause() {
+        mResumed = false;
+        mGeneration++;
+        unregisterDeviceCallbacks();
+        dismissDialog();
+        closeProxy();
+        closeLeProxy();
+    }
+
+    private Set<CachedBluetoothDevice> getDeviceGroup() {
+        return mTarget == null || mManager == null ? Collections.emptySet()
+                : Utils.findAllCachedBluetoothDevicesByGroupId(mManager, mTarget);
+    }
+
+    private void registerDeviceCallbacks() {
+        Set<CachedBluetoothDevice> group = getDeviceGroup();
+        if (group.equals(mRegisteredDevices)) return;
+        unregisterDeviceCallbacks();
+        mRegisteredDevices = group;
+        for (CachedBluetoothDevice device : group) {
+            device.registerCallback(mContext.getMainExecutor(), this);
+        }
+    }
+
+    private void unregisterDeviceCallbacks() {
+        for (CachedBluetoothDevice device : mRegisteredDevices) device.unregisterCallback(this);
+        mRegisteredDevices = Collections.emptySet();
+    }
+
+    @Override
+    public void onDeviceAttributesChanged() {
+        refresh();
+        mOnStateChanged.run();
+    }
+
+    private A2dpProfile getProfile() {
+        return mManager == null ? null : mManager.getProfileManager().getA2dpProfile();
+    }
+
+    private BluetoothCodecStatus getCodecStatus() {
+        A2dpProfile profile = getProfile();
+        if (mTarget == null || profile == null || !profile.isProfileReady() || mIsBlocked.getAsBoolean()) {
+            return null;
+        }
+        BluetoothDevice device = mTarget.getDevice();
+        Set<CachedBluetoothDevice> group = getDeviceGroup();
+        if (!profile.isEnabled(device)
+                || profile.getConnectionStatus(device) != BluetoothProfile.STATE_CONNECTED
+                || mTarget.isBusy() || group.stream().anyMatch(CachedBluetoothDevice::isBusy)) {
+            return null;
+        }
+        if (mRequireActiveTarget && (!device.equals(profile.getActiveDevice())
+                || group.stream().anyMatch(item -> item.isActiveDevice(BluetoothProfile.LE_AUDIO)))) {
+            return null;
+        }
+        return profile.getCodecStatus(device);
+    }
+
+    private List<BluetoothCodecType> getSelectableCodecTypes(BluetoothCodecStatus status) {
+        List<BluetoothCodecType> result = new ArrayList<>();
+        if (status == null || status.getCodecConfig() == null
+                || status.getCodecConfig().getExtendedCodecType() == null) return result;
+        List<BluetoothCodecConfig> capabilities = new ArrayList<>(status.getCodecsSelectableCapabilities());
+        capabilities.removeIf(config -> config == null || config.getExtendedCodecType() == null
+                || config.getCodecPriority() == BluetoothCodecConfig.CODEC_PRIORITY_DISABLED);
+        capabilities.sort(Comparator.comparingInt(BluetoothCodecConfig::getCodecPriority)
+                .reversed().thenComparingLong(config -> config.getExtendedCodecType().getCodecId()));
+        // The service rejects requests until mandatory SBC is known selectable.
+        if (capabilities.stream().noneMatch(BluetoothCodecConfig::isMandatoryCodec)) return result;
+        boolean hdEnabled = getProfile().isHighQualityAudioEnabled(mTarget.getDevice());
+        for (BluetoothCodecConfig config : capabilities) {
+            if (!hdEnabled && !config.isMandatoryCodec()) continue;
+            BluetoothCodecType type = config.getExtendedCodecType();
+            if (!result.contains(type)) result.add(type);
+        }
+        return result;
+    }
+
+    public boolean canShowDialog() {
+        if (isLeAudioRoute()) {
+            return mResumed && !LeOptions.of(getLeCodecStatus(), LeParameter.CODEC).isEmpty();
+        }
+        return mResumed && mBluetoothA2dp != null
+                && !getSelectableCodecTypes(getCodecStatus()).isEmpty();
+    }
+
+    public CharSequence getSummary() {
+        if (isLeAudioRoute()) return getLeSummary();
+        BluetoothCodecStatus status = getCodecStatus();
+        BluetoothCodecConfig current = status == null ? null : status.getCodecConfig();
+        if (current == null || current.getExtendedCodecType() == null) {
+            return mContext.getString(R.string.bluetooth_codec_menu_unavailable);
+        }
+        String name = current.getExtendedCodecType().getCodecName();
+        int rateHz = getSampleRateHz(current.getSampleRate());
+        // NONE and capability bitmasks do not establish an actual sample rate.
+        return rateHz == 0 ? name : mContext.getString(R.string.bluetooth_codec_menu_current,
+                name, formatSampleRate(rateHz));
+    }
+
+    private static int getSampleRateHz(int sampleRate) {
+        return switch (sampleRate) {
+            case BluetoothCodecConfig.SAMPLE_RATE_44100 -> 44100;
+            case BluetoothCodecConfig.SAMPLE_RATE_48000 -> 48000;
+            case BluetoothCodecConfig.SAMPLE_RATE_88200 -> 88200;
+            case BluetoothCodecConfig.SAMPLE_RATE_96000 -> 96000;
+            case BluetoothCodecConfig.SAMPLE_RATE_176400 -> 176400;
+            case BluetoothCodecConfig.SAMPLE_RATE_192000 -> 192000;
+            default -> 0;
+        };
+    }
+
+    private String formatSampleRate(int rateHz) {
+        // Hz to kHz; fractional rates retain the locale's decimal separator.
+        return NumberFormat.getNumberInstance(
+                mContext.getResources().getConfiguration().getLocales().get(0))
+                .format(rateHz / 1000.0);
+    }
+
+    @VisibleForTesting
+    List<Integer> getSelectableSampleRates(BluetoothCodecStatus status) {
+        if (status == null || status.getCodecConfig() == null) return Collections.emptyList();
+        BluetoothCodecType type = status.getCodecConfig().getExtendedCodecType();
+        if (!getSelectableCodecTypes(status).contains(type)) return Collections.emptyList();
+        int supportedRates = 0;
+        for (BluetoothCodecConfig config : status.getCodecsSelectableCapabilities()) {
+            if (config != null && type.equals(config.getExtendedCodecType())
+                    && config.getCodecPriority() != BluetoothCodecConfig.CODEC_PRIORITY_DISABLED) {
+                supportedRates |= config.getSampleRate();
+            }
+        }
+        // Only actual rates. "Automatic" (NONE) is not offered: the stack then takes the audio
+        // output's rate or the codec default, which is nearly always the rate already playing.
+        List<Integer> rates = new ArrayList<>();
+        for (int rate : new int[] {
+                BluetoothCodecConfig.SAMPLE_RATE_44100, BluetoothCodecConfig.SAMPLE_RATE_48000,
+                BluetoothCodecConfig.SAMPLE_RATE_88200, BluetoothCodecConfig.SAMPLE_RATE_96000,
+                BluetoothCodecConfig.SAMPLE_RATE_176400, BluetoothCodecConfig.SAMPLE_RATE_192000}) {
+            if ((supportedRates & rate) != 0
+                    && status.isCodecConfigSelectable(new BluetoothCodecConfig.Builder()
+                            .setExtendedCodecType(type).setSampleRate(rate).build())) {
+                rates.add(rate);
+            }
+        }
+        return rates;
+    }
+
+    @VisibleForTesting
+    boolean requestSampleRate(BluetoothCodecType type, int sampleRate) {
+        if (!mResumed || mBluetoothA2dp == null) return false;
+        BluetoothCodecStatus freshStatus = getCodecStatus();
+        if (freshStatus == null || freshStatus.getCodecConfig() == null
+                || !type.equals(freshStatus.getCodecConfig().getExtendedCodecType())
+                || !getSelectableSampleRates(freshStatus).contains(sampleRate)) return false;
+        BluetoothCodecConfig request = new BluetoothCodecConfig.Builder()
+                .setExtendedCodecType(type)
+                .setCodecPriority(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST)
+                .setSampleRate(sampleRate).build();
+        if (!freshStatus.isCodecConfigSelectable(request)) return false;
+        try {
+            mBluetoothA2dp.setCodecConfigPreference(mTarget.getDevice(), request);
+        } catch (IllegalArgumentException | SecurityException e) {
+            Log.w(TAG, "Sample rate request rejected", e);
+            return false;
+        }
+        // Submission is not readback. Only the codec broadcast supplies the actual rate.
+        refresh();
+        mOnStateChanged.run();
+        return true;
+    }
+
+    public void showDialog() {
+        dismissDialog();
+        if (isLeAudioRoute()) {
+            showLeChoices(LeParameter.CODEC);
+            return;
+        }
+        if (!canShowDialog()) return;
+        BluetoothCodecStatus status = getCodecStatus();
+        List<BluetoothCodecType> types = getSelectableCodecTypes(status);
+        if (types.isEmpty()) return;
+        final CachedBluetoothDevice target = mTarget;
+        final int generation = mGeneration;
+        CharSequence[] labels = types.stream().map(BluetoothCodecType::getCodecName)
+                .toArray(CharSequence[]::new);
+        int selected = types.indexOf(status.getCodecConfig().getExtendedCodecType());
+        TextView hint = new TextView(mContext);
+        hint.setText(R.string.bluetooth_codec_menu_connection_hint);
+        // A bare TextView sits on the dialog edge; give it the dialog's own content padding.
+        TypedValue padding = new TypedValue();
+        int paddingPx = mContext.getTheme().resolveAttribute(
+                android.R.attr.dialogPreferredPadding, padding, true)
+                ? TypedValue.complexToDimensionPixelSize(padding.data,
+                        mContext.getResources().getDisplayMetrics())
+                : 0;
+        hint.setPadding(paddingPx, paddingPx / 2, paddingPx, 0);
+        AlertDialog dialog = new AlertDialog.Builder(mContext)
+                .setTitle(R.string.bluetooth_codec_menu_title)
+                .setSingleChoiceItems(labels, selected, (ignored, index) -> {
+                    dismissDialog();
+                    if (index < 0 || index >= types.size() || !mResumed || mBluetoothA2dp == null
+                            || generation != mGeneration || !Objects.equals(target, mTarget)) return;
+                    BluetoothCodecType type = types.get(index);
+                    BluetoothCodecStatus freshStatus = getCodecStatus();
+                    if (getSelectableCodecTypes(freshStatus).contains(type)) {
+                        BluetoothCodecConfig request = new BluetoothCodecConfig.Builder()
+                                .setExtendedCodecType(type)
+                                .setCodecPriority(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST)
+                                .build();
+                        // Request only the type; rates and codec-specific fields remain AUTO.
+                        if (freshStatus.isCodecConfigSelectable(request)) {
+                            try {
+                                mBluetoothA2dp.setCodecConfigPreference(target.getDevice(), request);
+                            } catch (IllegalArgumentException | SecurityException e) {
+                                Log.w(TAG, "Codec request rejected", e);
+                            }
+                        }
+                    }
+                    // The setter returns void. The live codec status supplies every summary.
+                    refresh();
+                    mOnStateChanged.run();
+                })
+                .setView(hint)
+                .setNegativeButton(android.R.string.cancel, null)
+                .create();
+        mDialog = dialog;
+        mDialogTypes = List.copyOf(types);
+        dialog.setOnDismissListener(ignored -> {
+            if (mDialog == dialog) {
+                mDialog = null;
+                mDialogTypes = Collections.emptyList();
+            }
+        });
+        dialog.show();
+    }
+
+    /** True when the current codec offers a choice, i.e. at least two sample rates. */
+    public boolean canShowSampleRateDialog() {
+        if (isLeAudioRoute()) {
+            return mResumed && LeOptions.of(getLeCodecStatus(), LeParameter.RATE).size() > 1;
+        }
+        return canShowDialog() && getSelectableSampleRates(getCodecStatus()).size() > 1;
+    }
+
+    /** Read-back sample rate of the active codec; "unavailable" when the stack reports none. */
+    public CharSequence getSampleRateSummary() {
+        if (isLeAudioRoute()) {
+            BluetoothLeAudioCodecStatus status = getLeCodecStatus();
+            BluetoothLeAudioCodecConfig current = status == null ? null : status.getOutputCodecConfig();
+            return leRateLabel(current == null ? 0 : current.getSampleRate());
+        }
+        BluetoothCodecStatus status = getCodecStatus();
+        BluetoothCodecConfig current = status == null ? null : status.getCodecConfig();
+        int rateHz = current == null ? 0 : getSampleRateHz(current.getSampleRate());
+        return rateHz == 0 ? mContext.getString(R.string.bluetooth_codec_menu_unavailable)
+                : mContext.getString(R.string.bluetooth_codec_sample_rate_value,
+                        formatSampleRate(rateHz));
+    }
+
+    public void showSampleRateDialog() {
+        dismissDialog();
+        if (isLeAudioRoute()) {
+            showLeChoices(LeParameter.RATE);
+            return;
+        }
+        if (!canShowDialog()) return;
+        BluetoothCodecStatus status = getCodecStatus();
+        List<Integer> rates = getSelectableSampleRates(status);
+        if (rates.isEmpty()) return;
+        final BluetoothCodecType type = status.getCodecConfig().getExtendedCodecType();
+        final CachedBluetoothDevice target = mTarget;
+        final int generation = mGeneration;
+        CharSequence[] labels = rates.stream().map(rate ->
+                mContext.getString(R.string.bluetooth_codec_sample_rate_value,
+                        formatSampleRate(getSampleRateHz(rate))))
+                .toArray(CharSequence[]::new);
+        AlertDialog dialog = new AlertDialog.Builder(mContext)
+                .setTitle(R.string.bluetooth_codec_sample_rate_title)
+                .setSingleChoiceItems(labels, rates.indexOf(status.getCodecConfig().getSampleRate()),
+                        (ignored, index) -> {
+                            dismissDialog();
+                            if (index >= 0 && index < rates.size() && generation == mGeneration
+                                    && Objects.equals(target, mTarget)) {
+                                requestSampleRate(type, rates.get(index));
+                            }
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .create();
+        mDialog = dialog;
+        mDialogRates = List.copyOf(rates);
+        mDialogRateCodec = type;
+        dialog.setOnDismissListener(ignored -> {
+            if (mDialog == dialog) {
+                mDialog = null;
+                mDialogRates = Collections.emptyList();
+                mDialogRateCodec = null;
+            }
+        });
+        dialog.show();
+    }
+
+    public void refresh() {
+        if (mResumed) registerDeviceCallbacks();
+        if (mLeDialog != null) refreshLeDialog();
+        if (mDialog == null) return;
+        BluetoothCodecStatus status = getCodecStatus();
+        if (mDialogRateCodec != null) {
+            if (!mResumed || mBluetoothA2dp == null || status == null
+                    || status.getCodecConfig() == null
+                    || !mDialogRateCodec.equals(status.getCodecConfig().getExtendedCodecType())
+                    || !getSelectableSampleRates(status).equals(mDialogRates)) {
+                dismissDialog();
+            } else {
+                int selected = mDialogRates.indexOf(status.getCodecConfig().getSampleRate());
+                mDialog.getListView().clearChoices();
+                if (selected >= 0) mDialog.getListView().setItemChecked(selected, true);
+            }
+            return;
+        }
+        if (!mResumed || mBluetoothA2dp == null
+                || !getSelectableCodecTypes(status).equals(mDialogTypes)) {
+            dismissDialog();
+        } else {
+            int selected = mDialogTypes.indexOf(status.getCodecConfig().getExtendedCodecType());
+            mDialog.getListView().clearChoices();
+            if (selected >= 0) mDialog.getListView().setItemChecked(selected, true);
+        }
+    }
+
+    private void dismissDialog() {
+        dismissLeDialog();
+        if (mDialog == null) return;
+        AlertDialog dialog = mDialog;
+        mDialog = null;
+        mDialogTypes = Collections.emptyList();
+        mDialogRates = Collections.emptyList();
+        mDialogRateCodec = null;
+        dialog.dismiss();
+    }
+
+    private void requestProxy() {
+        if (!mResumed || mTarget == null || mBluetoothAdapter == null || mOwnedA2dpProxy != null) return;
+        final int generation = ++mGeneration;
+        mA2dpServiceListener = new BluetoothProfile.ServiceListener() {
+            @Override
+            public void onServiceConnected(int profile, BluetoothProfile proxy) {
+                if (profile != BluetoothProfile.A2DP || !(proxy instanceof BluetoothA2dp)) return;
+                if (!mResumed || generation != mGeneration) {
+                    mBluetoothAdapter.closeProfileProxy(BluetoothProfile.A2DP, proxy);
+                    return;
+                }
+                if (mOwnedA2dpProxy != proxy) closeProxy();
+                mOwnedA2dpProxy = (BluetoothA2dp) proxy;
+                mBluetoothA2dp = (BluetoothA2dp) proxy;
+                refresh();
+                mOnStateChanged.run();
+            }
+
+            @Override
+            public void onServiceDisconnected(int profile) {
+                if (profile == BluetoothProfile.A2DP && generation == mGeneration) {
+                    dismissDialog();
+                    mBluetoothA2dp = null;
+                    mOnStateChanged.run();
+                }
+            }
+        };
+        mBluetoothAdapter.getProfileProxy(mContext, mA2dpServiceListener, BluetoothProfile.A2DP);
+    }
+
+    private void closeProxy() {
+        BluetoothA2dp proxy = mOwnedA2dpProxy;
+        mOwnedA2dpProxy = null;
+        mBluetoothA2dp = null;
+        if (proxy != null && mBluetoothAdapter != null) {
+            mBluetoothAdapter.closeProfileProxy(BluetoothProfile.A2DP, proxy);
+        }
+    }
+
+    private boolean isLeAudioRoute() {
+        return getDeviceGroup().stream()
+                .anyMatch(device -> device.isActiveDevice(BluetoothProfile.LE_AUDIO));
+    }
+
+    private int getLeGroupId() {
+        if (!mResumed || mBluetoothLeAudio == null || mTarget == null || !isLeAudioRoute()) return -1;
+        try {
+            return mBluetoothLeAudio.getGroupId(mTarget.getDevice());
+        } catch (IllegalArgumentException | IllegalStateException | SecurityException e) {
+            Log.w(TAG, "LE group unavailable", e);
+            return -1;
+        }
+    }
+
+    private BluetoothLeAudioCodecStatus getLeCodecStatus() {
+        int groupId = getLeGroupId();
+        if (groupId < 0 || mTarget.isBusy()
+                || getDeviceGroup().stream().anyMatch(CachedBluetoothDevice::isBusy)) return null;
+        try {
+            boolean connected = getDeviceGroup().stream().anyMatch(device ->
+                    mBluetoothLeAudio.getConnectionState(device.getDevice()) == BluetoothProfile.STATE_CONNECTED);
+            return connected ? mBluetoothLeAudio.getCodecStatus(groupId) : null;
+        } catch (IllegalArgumentException | IllegalStateException | SecurityException e) {
+            Log.w(TAG, "LE codec status unavailable", e);
+            return null;
+        }
+    }
+
+    private String leCodecName(int type) {
+        return switch (type) {
+            case BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_LC3 -> "LC3";
+            case BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_OPUS -> "Opus";
+            case BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_OPUS_HI_RES -> "Opus Hi-res";
+            default -> mContext.getString(R.string.bluetooth_codec_menu_unavailable);
+        };
+    }
+
+    private String leRateLabel(int rate) {
+        int rateHz = LeOptions.rateHz(rate);
+        return rateHz == 0 ? mContext.getString(R.string.bluetooth_codec_menu_unavailable)
+                : mContext.getString(R.string.bluetooth_codec_sample_rate_value, formatSampleRate(rateHz));
+    }
+
+    private String leFrameLabel(int frame) {
+        int frameUs = LeOptions.frameUs(frame);
+        // Microseconds to milliseconds; only scalar reported durations are displayed.
+        return frameUs == 0 ? mContext.getString(R.string.bluetooth_codec_menu_unavailable)
+                : mContext.getString(R.string.bluetooth_codec_le_frame_value,
+                        NumberFormat.getNumberInstance(mContext.getResources().getConfiguration()
+                                .getLocales().get(0)).format(frameUs / 1000.0));
+    }
+
+    private CharSequence getLeSummary() {
+        BluetoothLeAudioCodecStatus status = getLeCodecStatus();
+        BluetoothLeAudioCodecConfig current = status == null ? null : status.getOutputCodecConfig();
+        if (current == null) return mContext.getString(R.string.bluetooth_codec_menu_unavailable);
+        String octets = current.getOctetsPerFrame() > 0
+                ? mContext.getString(R.string.bluetooth_codec_le_octets_value, current.getOctetsPerFrame())
+                : mContext.getString(R.string.bluetooth_codec_menu_unavailable);
+        return mContext.getString(R.string.bluetooth_codec_le_current, leCodecName(current.getCodecType()),
+                leRateLabel(current.getSampleRate()), leFrameLabel(current.getFrameDuration()), octets);
+    }
+
+    private int leTitle(LeParameter parameter) {
+        return switch (parameter) {
+            case CODEC -> R.string.bluetooth_codec_menu_title;
+            case RATE -> R.string.bluetooth_codec_sample_rate_title;
+            case FRAME -> R.string.bluetooth_codec_le_frame_title;
+            case OCTETS -> R.string.bluetooth_codec_le_octets_title;
+        };
+    }
+
+    private String leLabel(BluetoothLeAudioCodecConfig option, LeParameter parameter) {
+        return switch (parameter) {
+            case CODEC -> leCodecName(option.getCodecType());
+            case RATE -> leRateLabel(option.getSampleRate());
+            case FRAME -> leFrameLabel(option.getFrameDuration());
+            case OCTETS -> mContext.getString(R.string.bluetooth_codec_le_octets_value, option.getOctetsPerFrame());
+        };
+    }
+
+    public boolean canShowFrameDurationDialog() {
+        return mResumed && isLeAudioRoute()
+                && LeOptions.of(getLeCodecStatus(), LeParameter.FRAME).size() > 1;
+    }
+
+    public CharSequence getFrameDurationSummary() {
+        BluetoothLeAudioCodecStatus status = getLeCodecStatus();
+        BluetoothLeAudioCodecConfig current = status == null ? null : status.getOutputCodecConfig();
+        return leFrameLabel(current == null ? 0 : current.getFrameDuration());
+    }
+
+    public void showFrameDurationDialog() {
+        if (canShowFrameDurationDialog()) showLeChoices(LeParameter.FRAME);
+    }
+
+    public boolean canShowOctetsDialog() {
+        return mResumed && isLeAudioRoute()
+                && LeOptions.of(getLeCodecStatus(), LeParameter.OCTETS).size() > 1;
+    }
+
+    public CharSequence getOctetsSummary() {
+        BluetoothLeAudioCodecStatus status = getLeCodecStatus();
+        BluetoothLeAudioCodecConfig current = status == null ? null : status.getOutputCodecConfig();
+        return current == null || current.getOctetsPerFrame() <= 0
+                ? mContext.getString(R.string.bluetooth_codec_menu_unavailable)
+                : mContext.getString(R.string.bluetooth_codec_le_octets_value, current.getOctetsPerFrame());
+    }
+
+    public void showOctetsDialog() {
+        if (canShowOctetsDialog()) showLeChoices(LeParameter.OCTETS);
+    }
+
+    private void showLeChoices(LeParameter parameter) {
+        dismissDialog();
+        BluetoothLeAudioCodecStatus status = getLeCodecStatus();
+        List<BluetoothLeAudioCodecConfig> options = LeOptions.of(status, parameter);
+        if (options.isEmpty()) return;
+        final int groupId = getLeGroupId();
+        final int generation = mGeneration;
+        final int type = status.getOutputCodecConfig().getCodecType();
+        int currentValue = LeOptions.value(status.getOutputCodecConfig(), parameter);
+        int selected = -1;
+        for (int index = 0; index < options.size(); index++) {
+            if (LeOptions.value(options.get(index), parameter) == currentValue) selected = index;
+        }
+        CharSequence[] labels = options.stream().map(option -> leLabel(option, parameter))
+                .toArray(CharSequence[]::new);
+        AlertDialog dialog = new AlertDialog.Builder(mContext).setTitle(leTitle(parameter))
+                .setSingleChoiceItems(labels, selected, (ignored, index) -> {
+                    dismissLeDialog();
+                    if (index >= 0 && index < options.size()) {
+                        requestLePreference(groupId, generation, type, parameter, options.get(index));
+                    }
+                }).setNegativeButton(android.R.string.cancel, null).create();
+        mLeDialog = dialog;
+        mLeDialogGroupId = groupId;
+        mLeDialogCodecType = type;
+        mLeDialogParameter = parameter;
+        mLeDialogOptions = List.copyOf(options);
+        dialog.setOnDismissListener(ignored -> {
+            if (mLeDialog == dialog) dismissLeDialog();
+        });
+        dialog.show();
+    }
+
+    @VisibleForTesting
+    boolean requestLePreference(int groupId, int generation, int codecType, LeParameter parameter,
+            BluetoothLeAudioCodecConfig output) {
+        if (!mResumed || mBluetoothLeAudio == null || generation != mGeneration
+                || groupId < 0 || groupId != getLeGroupId()) return false;
+        BluetoothLeAudioCodecStatus fresh = getLeCodecStatus();
+        if (fresh == null || fresh.getOutputCodecConfig() == null
+                || fresh.getOutputCodecConfig().getCodecType() != codecType
+                || !LeOptions.of(fresh, parameter).contains(output)) return false;
+        try {
+            mBluetoothLeAudio.setCodecConfigPreference(groupId, LeOptions.inputFor(output), output);
+        } catch (IllegalArgumentException | IllegalStateException | SecurityException e) {
+            Log.w(TAG, "LE codec preference rejected", e);
+            return false;
+        }
+        // A submitted preference is not the stream status. Poll/callback readback supplies the UI.
+        refresh();
+        mOnStateChanged.run();
+        return true;
+    }
+
+    private void refreshLeDialog() {
+        BluetoothLeAudioCodecStatus status = getLeCodecStatus();
+        if (status == null || status.getOutputCodecConfig() == null
+                || mLeDialogGroupId != getLeGroupId()
+                || mLeDialogCodecType != status.getOutputCodecConfig().getCodecType()) {
+            dismissLeDialog();
+            return;
+        }
+        if (!LeOptions.of(status, mLeDialogParameter).equals(mLeDialogOptions)) {
+            dismissLeDialog();
+            return;
+        }
+        int current = LeOptions.value(status.getOutputCodecConfig(), mLeDialogParameter);
+        mLeDialog.getListView().clearChoices();
+        for (int index = 0; index < mLeDialogOptions.size(); index++) {
+            if (LeOptions.value(mLeDialogOptions.get(index), mLeDialogParameter) == current) {
+                mLeDialog.getListView().setItemChecked(index, true);
+            }
+        }
+    }
+
+    private void dismissLeDialog() {
+        AlertDialog dialog = mLeDialog;
+        mLeDialog = null;
+        mLeDialogGroupId = -1;
+        mLeDialogParameter = null;
+        mLeDialogOptions = Collections.emptyList();
+        if (dialog != null) dialog.dismiss();
+    }
+
+    private void requestLeProxy() {
+        if (!mResumed || mTarget == null || mBluetoothAdapter == null
+                || mOwnedLeProxy != null || mLeProxyPending) return;
+        final int generation = mGeneration;
+        mLeProxyPending = true;
+        BluetoothProfile.ServiceListener listener = new BluetoothProfile.ServiceListener() {
+            @Override
+            public void onServiceConnected(int profile, BluetoothProfile proxy) {
+                if (profile != BluetoothProfile.LE_AUDIO || !(proxy instanceof BluetoothLeAudio leAudio)) return;
+                if (!mResumed || generation != mGeneration) {
+                    if (proxy != mOwnedLeProxy) mBluetoothAdapter.closeProfileProxy(BluetoothProfile.LE_AUDIO, proxy);
+                    return;
+                }
+                if (mOwnedLeProxy == leAudio && mLeCallback != null) {
+                    mLeProxyPending = false;
+                    return;
+                }
+                closeLeProxy();
+                mOwnedLeProxy = leAudio;
+                mBluetoothLeAudio = leAudio;
+                BluetoothLeAudio.Callback callback = new BluetoothLeAudio.Callback() {
+                    private void changed() {
+                        if (mResumed && generation == mGeneration && mBluetoothLeAudio == leAudio) {
+                            refresh();
+                            mOnStateChanged.run();
+                        }
+                    }
+                    @Override public void onCodecConfigChanged(int groupId, BluetoothLeAudioCodecStatus status) {
+                        if (groupId == getLeGroupId()) changed();
+                    }
+                    @Override public void onGroupNodeAdded(BluetoothDevice device, int groupId) { changed(); }
+                    @Override public void onGroupNodeRemoved(BluetoothDevice device, int groupId) { changed(); }
+                    @Override public void onGroupStatusChanged(int groupId, int groupStatus) { changed(); }
+                };
+                try {
+                    leAudio.registerCallback(mContext.getMainExecutor(), callback);
+                    mLeCallback = callback;
+                } catch (IllegalArgumentException | IllegalStateException | SecurityException e) {
+                    Log.w(TAG, "LE callback registration rejected", e);
+                    closeLeProxy();
+                }
+                refresh();
+                mOnStateChanged.run();
+            }
+            @Override
+            public void onServiceDisconnected(int profile) {
+                if (profile == BluetoothProfile.LE_AUDIO && generation == mGeneration) {
+                    dismissLeDialog();
+                    closeLeProxy();
+                    mOnStateChanged.run();
+                }
+            }
+        };
+        try {
+            mLeProxyPending = mBluetoothAdapter.getProfileProxy(mContext, listener, BluetoothProfile.LE_AUDIO);
+        } catch (IllegalArgumentException | IllegalStateException | SecurityException e) {
+            mLeProxyPending = false;
+            Log.w(TAG, "LE proxy unavailable", e);
+        }
+    }
+
+    private void closeLeProxy() {
+        BluetoothLeAudio proxy = mOwnedLeProxy;
+        BluetoothLeAudio.Callback callback = mLeCallback;
+        mOwnedLeProxy = null;
+        mBluetoothLeAudio = null;
+        mLeCallback = null;
+        mLeProxyPending = false;
+        if (proxy == null) return;
+        if (callback != null) {
+            try {
+                proxy.unregisterCallback(callback);
+            } catch (IllegalArgumentException | IllegalStateException | SecurityException e) {
+                Log.w(TAG, "LE callback already unavailable", e);
+            }
+        }
+        if (mBluetoothAdapter != null) mBluetoothAdapter.closeProfileProxy(BluetoothProfile.LE_AUDIO, proxy);
+    }
+
+    enum LeParameter { CODEC, RATE, FRAME, OCTETS }
+
+    /** LE choices are per direction and configuration, never a union of unrelated PAC records. */
+    static final class LeOptions {
+        static boolean known(int type) {
+            return type == BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_LC3
+                    || type == BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_OPUS
+                    || type == BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_OPUS_HI_RES;
+        }
+
+        static BluetoothLeAudioCodecConfig inputFor(BluetoothLeAudioCodecConfig output) {
+            // The microphone has its own rate/frame limits; do not copy sink parameters to it.
+            return new BluetoothLeAudioCodecConfig.Builder().setCodecType(output.getCodecType())
+                    .setCodecPriority(BluetoothLeAudioCodecConfig.CODEC_PRIORITY_HIGHEST).build();
+        }
+
+        private static List<BluetoothLeAudioCodecConfig> enabled(
+                List<BluetoothLeAudioCodecConfig> capabilities) {
+            List<BluetoothLeAudioCodecConfig> result = new ArrayList<>();
+            if (capabilities == null) return result;
+            for (BluetoothLeAudioCodecConfig capability : capabilities) {
+                if (capability != null && known(capability.getCodecType())
+                        && capability.getCodecPriority()
+                                != BluetoothLeAudioCodecConfig.CODEC_PRIORITY_DISABLED) {
+                    result.add(capability);
+                }
+            }
+            return result;
+        }
+
+        static boolean selectable(BluetoothLeAudioCodecStatus status,
+                BluetoothLeAudioCodecConfig output) {
+            if (status == null || output == null || !known(output.getCodecType())) return false;
+            BluetoothLeAudioCodecStatus filtered = new BluetoothLeAudioCodecStatus(
+                    status.getInputCodecConfig(), status.getOutputCodecConfig(),
+                    Collections.emptyList(), Collections.emptyList(),
+                    enabled(status.getInputCodecSelectableCapabilities()),
+                    enabled(status.getOutputCodecSelectableCapabilities()));
+            return filtered.isInputCodecConfigSelectable(inputFor(output))
+                    && filtered.isOutputCodecConfigSelectable(output);
+        }
+
+        static int rateHz(int rate) {
+            return switch (rate) {
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_8000 -> 8000;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_11025 -> 11025;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_16000 -> 16000;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_22050 -> 22050;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_24000 -> 24000;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_32000 -> 32000;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_44100 -> 44100;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_48000 -> 48000;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_88200 -> 88200;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_96000 -> 96000;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_176400 -> 176400;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_192000 -> 192000;
+                case BluetoothLeAudioCodecConfig.SAMPLE_RATE_384000 -> 384000;
+                default -> 0;
+            };
+        }
+
+        static int frameUs(int frame) {
+            return switch (frame) {
+                case BluetoothLeAudioCodecConfig.FRAME_DURATION_7500 -> 7500;
+                case BluetoothLeAudioCodecConfig.FRAME_DURATION_10000 -> 10000;
+                default -> 0;
+            };
+        }
+
+        static int value(BluetoothLeAudioCodecConfig config, LeParameter parameter) {
+            return switch (parameter) {
+                case CODEC -> config.getCodecType();
+                case RATE -> config.getSampleRate();
+                case FRAME -> config.getFrameDuration();
+                case OCTETS -> config.getOctetsPerFrame();
+            };
+        }
+
+        static List<BluetoothLeAudioCodecConfig> of(
+                BluetoothLeAudioCodecStatus status, LeParameter parameter) {
+            List<BluetoothLeAudioCodecConfig> result = new ArrayList<>();
+            BluetoothLeAudioCodecConfig current = status == null ? null : status.getOutputCodecConfig();
+            if (current == null || !known(current.getCodecType())) return result;
+            List<Integer> values = new ArrayList<>();
+            switch (parameter) {
+                case CODEC -> values.addAll(List.of(
+                        BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_LC3,
+                        BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_OPUS,
+                        BluetoothLeAudioCodecConfig.SOURCE_CODEC_TYPE_OPUS_HI_RES));
+                case RATE -> {
+                    // The 13 rates are individual bits in the documented LE frequency mask.
+                    for (int bit = 0; bit < 13; bit++) values.add(1 << bit);
+                }
+                case FRAME -> values.addAll(List.of(
+                        BluetoothLeAudioCodecConfig.FRAME_DURATION_7500,
+                        BluetoothLeAudioCodecConfig.FRAME_DURATION_10000));
+                case OCTETS -> {
+                    if (rateHz(current.getSampleRate()) == 0
+                            || frameUs(current.getFrameDuration()) == 0) return result;
+                    for (BluetoothLeAudioCodecConfig capability :
+                            enabled(status.getOutputCodecSelectableCapabilities())) {
+                        int min = capability.getMinOctetsPerFrame();
+                        int max = capability.getMaxOctetsPerFrame();
+                        // Zero means unreported; native requests carry a uint16_t, not an int.
+                        if (min > 0 && max >= min && max <= 65535) {
+                            values.add(min);
+                            values.add(current.getOctetsPerFrame());
+                            values.add(max);
+                        }
+                    }
+                    values.sort(Integer::compare);
+                }
+            }
+            for (int value : values) {
+                if (parameter == LeParameter.OCTETS && value <= 0) continue;
+                int type = parameter == LeParameter.CODEC ? value : current.getCodecType();
+                int rate = parameter == LeParameter.RATE ? value
+                        : parameter == LeParameter.CODEC ? 0
+                        : rateHz(current.getSampleRate()) == 0 ? 0 : current.getSampleRate();
+                int frame = parameter == LeParameter.FRAME ? value
+                        : parameter == LeParameter.CODEC ? 0
+                        : frameUs(current.getFrameDuration()) == 0 ? 0 : current.getFrameDuration();
+                BluetoothLeAudioCodecConfig output = new BluetoothLeAudioCodecConfig.Builder()
+                        .setCodecType(type).setSampleRate(rate).setFrameDuration(frame)
+                        .setOctetsPerFrame(parameter == LeParameter.OCTETS ? value : 0)
+                        .setCodecPriority(BluetoothLeAudioCodecConfig.CODEC_PRIORITY_HIGHEST).build();
+                if (selectable(status, output) && !result.contains(output)) result.add(output);
+            }
+            return result;
+        }
+    }
+}
