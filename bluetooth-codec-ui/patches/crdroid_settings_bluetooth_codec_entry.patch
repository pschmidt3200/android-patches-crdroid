+
+/**
+ * "Audio codec" entry on the Connected devices page for the active A2DP or LE group.
+ *
+ * <p>Device details cannot host this entry for every sink: dual-mode devices lose the A2DP row
+ * and vendor-configured detail layouts hide the profile list. This entry depends only on the
+ * active audio device and reuses {@link BluetoothCodecDialogController}.
+ */
+public class BluetoothCodecEntryPreferenceController extends BasePreferenceController
+        implements DefaultLifecycleObserver, BluetoothCallback {
+    /** Sample-rate row below the codec entry; it has no controller of its own. */
+    static final String KEY_SAMPLE_RATE = "bluetooth_audio_sample_rate_entry";
+    static final String KEY_FRAME_DURATION = "bluetooth_audio_frame_duration_entry";
+    static final String KEY_OCTETS = "bluetooth_audio_octets_entry";
+
+    @Nullable private final LocalBluetoothManager mManager;
+    @Nullable private BluetoothCodecDialogController mCodecController;
+    @Nullable private Preference mPreference;
+    @Nullable private Preference mSampleRatePreference;
+    @Nullable private Preference mFrameDurationPreference;
+    @Nullable private Preference mOctetsPreference;
+    @Nullable private CachedBluetoothDevice mTarget;
+    private boolean mStarted;
+
+    public BluetoothCodecEntryPreferenceController(Context context, String key) {
+        super(context, key);
+        // No proxy or callback work here: search indexing constructs this controller too.
+        mManager = Utils.getLocalBtManager(context);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mManager != null ? AVAILABLE_UNSEARCHABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+        mSampleRatePreference = screen.findPreference(KEY_SAMPLE_RATE);
+        mFrameDurationPreference = screen.findPreference(KEY_FRAME_DURATION);
+        mOctetsPreference = screen.findPreference(KEY_OCTETS);
+        if (mSampleRatePreference != null) {
+            mSampleRatePreference.setVisible(false);
+        }
+        if (mFrameDurationPreference != null) mFrameDurationPreference.setVisible(false);
+        if (mOctetsPreference != null) mOctetsPreference.setVisible(false);
+        if (mPreference == null || mManager == null) {
+            return;
+        }
+        mPreference.setVisible(false);
+        // The dialog needs the themed screen context, not an application context.
+        mCodecController = new BluetoothCodecDialogController(screen.getContext(), mManager,
+                true, this::isLeAudioActiveForTarget, this::updatePreference);
+    }
+
+    @Override
+    public void onStart(@NonNull LifecycleOwner owner) {
+        if (mManager == null || mCodecController == null || mStarted) {
+            return;
+        }
+        mStarted = true;
+        mManager.getEventManager().registerCallback(this);
+        retarget();
+        mCodecController.onResume();
+        updatePreference();
+    }
+
+    @Override
+    public void onStop(@NonNull LifecycleOwner owner) {
+        if (!mStarted) {
+            return;
+        }
+        mStarted = false;
+        if (mManager != null) {
+            mManager.getEventManager().unregisterCallback(this);
+        }
+        if (mCodecController != null) {
+            mCodecController.onPause();
+        }
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (TextUtils.equals(preference.getKey(), KEY_FRAME_DURATION)) {
+            if (mCodecController != null && preference.isEnabled()) {
+                mCodecController.showFrameDurationDialog();
+            }
+            return true;
+        }
+        if (TextUtils.equals(preference.getKey(), KEY_OCTETS)) {
+            if (mCodecController != null && preference.isEnabled()) {
+                mCodecController.showOctetsDialog();
+            }
+            return true;
+        }
+        if (TextUtils.equals(preference.getKey(), KEY_SAMPLE_RATE)) {
+            if (mCodecController != null && preference.isEnabled()) {
+                mCodecController.showSampleRateDialog();
+            }
+            return true;
+        }
+        if (!TextUtils.equals(preference.getKey(), getPreferenceKey())) {
+            return false;
+        }
+        if (mCodecController != null && preference.isEnabled()) {
+            mCodecController.showDialog();
+        }
+        return true;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        updatePreference();
+    }
+
+    @Override
+    public void onActiveDeviceChanged(@Nullable CachedBluetoothDevice activeDevice,
+            int bluetoothProfile) {
+        if (bluetoothProfile == BluetoothProfile.A2DP
+                || bluetoothProfile == BluetoothProfile.LE_AUDIO) {
+            retargetAndUpdate();
+        }
+    }
+
+    @Override
+    public void onProfileConnectionStateChanged(@NonNull CachedBluetoothDevice cachedDevice,
+            int state, int bluetoothProfile) {
+        if (bluetoothProfile == BluetoothProfile.A2DP
+                || bluetoothProfile == BluetoothProfile.LE_AUDIO) {
+            retargetAndUpdate();
+        }
+    }
+
+    @Override
+    public void onAclConnectionStateChanged(@NonNull CachedBluetoothDevice cachedDevice,
+            int state) {
+        retargetAndUpdate();
+    }
+
+    @Override
+    public void onBluetoothStateChanged(int bluetoothState) {
+        retargetAndUpdate();
+    }
+
+    private void retargetAndUpdate() {
+        if (!mStarted) {
+            return;
+        }
+        retarget();
+        updatePreference();
+    }
+
+    private void retarget() {
+        if (mCodecController == null) {
+            return;
+        }
+        mTarget = findActiveAudioDevice();
+        mCodecController.setTarget(mTarget);
+    }
+
+    @Nullable
+    private CachedBluetoothDevice findActiveAudioDevice() {
+        if (mManager == null) {
+            return null;
+        }
+        LeAudioProfile leAudio = mManager.getProfileManager().getLeAudioProfile();
+        if (leAudio != null && leAudio.isProfileReady()) {
+            for (BluetoothDevice active : leAudio.getActiveDevices()) {
+                CachedBluetoothDevice cached = active == null ? null
+                        : mManager.getCachedDeviceManager().findDevice(active);
+                if (cached != null && cached.isActiveDevice(BluetoothProfile.LE_AUDIO)) return cached;
+            }
+        }
+        A2dpProfile a2dp = mManager.getProfileManager().getA2dpProfile();
+        if (a2dp == null || !a2dp.isProfileReady()) {
+            return null;
+        }
+        BluetoothDevice active = a2dp.getActiveDevice();
+        return active == null ? null : mManager.getCachedDeviceManager().findDevice(active);
+    }
+
+    private boolean isLeAudioActiveForTarget() {
+        CachedBluetoothDevice target = mTarget;
+        if (mManager == null || target == null) {
+            return false;
+        }
+        // LE support or an allowed connection policy does not establish the active audio route.
+        return Utils.findAllCachedBluetoothDevicesByGroupId(mManager, target).stream()
+                .anyMatch(device -> device.isActiveDevice(BluetoothProfile.LE_AUDIO));
+    }
+
+    private void updatePreference() {
+        if (mPreference == null || mCodecController == null) {
+            return;
+        }
+        // LE activation may remove the A2DP policy; the active LE group still has codec status.
+        A2dpProfile a2dp = mManager == null ? null
+                : mManager.getProfileManager().getA2dpProfile();
+        boolean a2dpConnected = mTarget != null && a2dp != null
+                && a2dp.getConnectionStatus(mTarget.getDevice()) == BluetoothProfile.STATE_CONNECTED;
+        boolean visible = mStarted && mTarget != null
+                && (a2dpConnected || isLeAudioActiveForTarget());
+        mPreference.setVisible(visible);
+        // The rate row follows the codec entry and only appears when the codec offers rates.
+        boolean rateVisible = visible && mCodecController.canShowSampleRateDialog();
+        if (mSampleRatePreference != null) {
+            mSampleRatePreference.setVisible(rateVisible);
+            if (rateVisible) {
+                mSampleRatePreference.setSummary(mCodecController.getSampleRateSummary());
+            }
+        }
+        boolean frameVisible = visible && mCodecController.canShowFrameDurationDialog();
+        if (mFrameDurationPreference != null) {
+            mFrameDurationPreference.setVisible(frameVisible);
+            if (frameVisible) {
+                mFrameDurationPreference.setSummary(mCodecController.getFrameDurationSummary());
+            }
+        }
+        boolean octetsVisible = visible && mCodecController.canShowOctetsDialog();
+        if (mOctetsPreference != null) {
+            mOctetsPreference.setVisible(octetsVisible);
+            if (octetsVisible) mOctetsPreference.setSummary(mCodecController.getOctetsSummary());
+        }
+        if (!visible) {
+            return;
+        }
+        mPreference.setSummary(mCodecController.getSummary());
+        mPreference.setEnabled(mCodecController.canShowDialog());
+    }
+}
