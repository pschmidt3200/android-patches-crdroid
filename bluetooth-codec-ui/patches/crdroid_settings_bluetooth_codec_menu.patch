+    @Test
+    public void codecMenu_selectionRequestsAutoFieldsAndWaitsForLiveStatus() {
+        showCodecScreen();
+        BluetoothCodecConfig sbc = codec(BluetoothCodecConfig.SOURCE_CODEC_TYPE_SBC,
+                BluetoothCodecConfig.SAMPLE_RATE_48000);
+        BluetoothCodecConfig aacCapability = new BluetoothCodecConfig.Builder()
+                .setExtendedCodecType(BluetoothCodecType.createFromType(
+                        BluetoothCodecConfig.SOURCE_CODEC_TYPE_AAC))
+                .setSampleRate(BluetoothCodecConfig.SAMPLE_RATE_48000
+                        | BluetoothCodecConfig.SAMPLE_RATE_96000)
+                .setBitsPerSample(BluetoothCodecConfig.BITS_PER_SAMPLE_16
+                        | BluetoothCodecConfig.BITS_PER_SAMPLE_24)
+                .setChannelMode(BluetoothCodecConfig.CHANNEL_MODE_STEREO)
+                .setCodecSpecific1(1234)
+                .build();
+        setCodecStatus(sbc, sbc, aacCapability);
+
+        shadowOf(openCodecDialog()).clickOnItem(1);
+
+        ArgumentCaptor<BluetoothCodecConfig> request =
+                ArgumentCaptor.forClass(BluetoothCodecConfig.class);
+        verify(mCodecService).setCodecConfigPreference(eq(mDevice), request.capture());
+        assertThat(request.getValue().getExtendedCodecType())
+                .isEqualTo(aacCapability.getExtendedCodecType());
+        assertThat(request.getValue().getCodecPriority())
+                .isEqualTo(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST);
+        assertThat(request.getValue().getSampleRate()).isEqualTo(BluetoothCodecConfig.SAMPLE_RATE_NONE);
+        assertThat(request.getValue().getBitsPerSample())
+                .isEqualTo(BluetoothCodecConfig.BITS_PER_SAMPLE_NONE);
+        assertThat(request.getValue().getChannelMode())
+                .isEqualTo(BluetoothCodecConfig.CHANNEL_MODE_NONE);
+        assertThat(request.getValue().getCodecSpecific1()).isEqualTo(0);
+        assertThat(request.getValue().getCodecSpecific2()).isEqualTo(0);
+        assertThat(request.getValue().getCodecSpecific3()).isEqualTo(0);
+        assertThat(request.getValue().getCodecSpecific4()).isEqualTo(0);
+        assertThat(getMediaAudioPref().getSummary().toString()).isEqualTo("SBC · 48 kHz");
+
+        setCodecStatus(codec(BluetoothCodecConfig.SOURCE_CODEC_TYPE_AAC,
+                BluetoothCodecConfig.SAMPLE_RATE_96000), sbc, aacCapability);
+        mController.onDeviceAttributesChanged();
+        assertThat(getMediaAudioPref().getSummary().toString()).isEqualTo("AAC · 96 kHz");
+    }
