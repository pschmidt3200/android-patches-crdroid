+    private BluetoothCodecStatus getCodecStatusForMenu(A2dpProfile profile) {
+        BluetoothDevice device = mCachedDevice.getDevice();
+        List<CachedBluetoothDevice> devices = mProfileDeviceMap.get(profile.toString());
+        if (!profile.isProfileReady() || !profile.isEnabled(device)
+                || profile.getConnectionStatus(device) != BluetoothProfile.STATE_CONNECTED
+                || mCachedDevice.isBusy() || isLeAudioEnabled()
+                || (devices != null && devices.stream().anyMatch(item -> item.isBusy()))) {
+            return null;
+        }
+        return profile.getCodecStatus(device);
+    }
+
+    private List<BluetoothCodecType> getSelectableCodecTypes(
+            A2dpProfile profile, BluetoothCodecStatus status) {
+        List<BluetoothCodecType> result = new ArrayList<>();
+        if (status == null || status.getCodecConfig() == null
+                || status.getCodecConfig().getExtendedCodecType() == null) {
+            return result;
+        }
+        List<BluetoothCodecConfig> capabilities =
+                new ArrayList<>(status.getCodecsSelectableCapabilities());
+        capabilities.removeIf(config -> config == null || config.getExtendedCodecType() == null
+                || config.getCodecPriority() == BluetoothCodecConfig.CODEC_PRIORITY_DISABLED);
+        capabilities.sort(Comparator.comparingInt(BluetoothCodecConfig::getCodecPriority)
+                .reversed().thenComparingLong(config -> config.getExtendedCodecType().getCodecId()));
+        // The Bluetooth service rejects requests until mandatory SBC is known selectable.
+        if (capabilities.stream().noneMatch(BluetoothCodecConfig::isMandatoryCodec)) {
+            return result;
+        }
+        boolean hdEnabled = profile.isHighQualityAudioEnabled(mCachedDevice.getDevice());
+        for (BluetoothCodecConfig config : capabilities) {
+            if (config == null || config.getCodecPriority()
+                    == BluetoothCodecConfig.CODEC_PRIORITY_DISABLED
+                    || (!hdEnabled && !config.isMandatoryCodec())) {
+                continue;
+            }
+            BluetoothCodecType type = config.getExtendedCodecType();
+            if (type != null && !result.contains(type)) {
+                result.add(type);
+            }
+        }
+        return result;
+    }
+
+    private CharSequence getCodecSummary(BluetoothCodecConfig codec) {
+        String name = codec.getExtendedCodecType().getCodecName();
+        int rateHz = switch (codec.getSampleRate()) {
+            case BluetoothCodecConfig.SAMPLE_RATE_44100 -> 44100;
+            case BluetoothCodecConfig.SAMPLE_RATE_48000 -> 48000;
+            case BluetoothCodecConfig.SAMPLE_RATE_88200 -> 88200;
+            case BluetoothCodecConfig.SAMPLE_RATE_96000 -> 96000;
+            case BluetoothCodecConfig.SAMPLE_RATE_176400 -> 176400;
+            case BluetoothCodecConfig.SAMPLE_RATE_192000 -> 192000;
+            default -> 0;
+        };
+        // NONE and capability bitmasks are not evidence of an active sample rate.
+        return rateHz == 0 ? name : mContext.getString(R.string.bluetooth_codec_menu_current,
+                name, NumberFormat.getNumberInstance(
+                        mContext.getResources().getConfiguration().getLocales().get(0))
+                        .format(rateHz / 1000.0));
+    }
+
+    private void showCodecDialog(A2dpProfile profile) {
+        dismissCodecDialog();
+        if (!mResumed || mBluetoothA2dp == null) {
+            return;
+        }
+        BluetoothCodecStatus status = getCodecStatusForMenu(profile);
+        List<BluetoothCodecType> types = getSelectableCodecTypes(profile, status);
+        if (types.isEmpty()) {
+            return;
+        }
+        CharSequence[] labels = types.stream().map(BluetoothCodecType::getCodecName)
+                .toArray(CharSequence[]::new);
+        int selected = types.indexOf(status.getCodecConfig().getExtendedCodecType());
+        TextView hint = new TextView(mContext);
+        hint.setText(R.string.bluetooth_codec_menu_connection_hint);
+        AlertDialog codecDialog = new AlertDialog.Builder(mContext)
+                .setTitle(R.string.bluetooth_codec_menu_title)
+                .setSingleChoiceItems(labels, selected, (dialog, index) -> {
+                    dismissCodecDialog();
+                    if (index < 0 || index >= types.size() || !mResumed
+                            || mBluetoothA2dp == null) {
+                        return;
+                    }
+                    BluetoothCodecType type = types.get(index);
+                    BluetoothCodecStatus freshStatus = getCodecStatusForMenu(profile);
+                    if (!getSelectableCodecTypes(profile, freshStatus).contains(type)) {
+                        refresh();
+                        return;
+                    }
+                    BluetoothCodecConfig request = new BluetoothCodecConfig.Builder()
+                            .setExtendedCodecType(type)
+                            .setCodecPriority(BluetoothCodecConfig.CODEC_PRIORITY_HIGHEST)
+                            .build();
+                    // Only the type is requested. Rates and codec-specific values remain AUTO;
+                    // copying sink capability bitmasks would not describe a selected config.
+                    if (freshStatus.isCodecConfigSelectable(request)) {
+                        try {
+                            mBluetoothA2dp.setCodecConfigPreference(
+                                    mCachedDevice.getDevice(), request);
+                        } catch (IllegalArgumentException | SecurityException e) {
+                            Log.w(TAG, "Codec request rejected", e);
+                        }
+                    }
+                    // The setter returns void; only the live codec status supplies the summary.
+                    refresh();
+                })
+                .setView(hint)
+                .setNegativeButton(android.R.string.cancel, null)
+                .create();
+        mCodecDialog = codecDialog;
+        mCodecDialogTypes = List.copyOf(types);
+        codecDialog.setOnDismissListener(dialog -> {
+            if (mCodecDialog == codecDialog) {
+                mCodecDialog = null;
+                mCodecDialogTypes = Collections.emptyList();
+            }
+        });
+        codecDialog.show();
+    }
+
+    private void dismissCodecDialog() {
+        if (mCodecDialog != null) {
+            AlertDialog dialog = mCodecDialog;
+            mCodecDialog = null;
+            mCodecDialogTypes = Collections.emptyList();
+            dialog.dismiss();
+        }
+    }
