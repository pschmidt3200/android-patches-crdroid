# Target repository: bionic
# Maintenance: README.md
# crDroid 16.0: allow Morphe ART runtime to load ROM framework resources.
# Reference: fcfacc3e0ba78b59de4bdd46b8bec3676e5c305c
# No blanket app_process exemption; defer caching until its final name.
--- a/libc/bionic/custom_rom_hide.cpp
+++ b/libc/bionic/custom_rom_hide.cpp
@@ -131,6 +131,7 @@
 
 static const char* const kAllowlistedPackages[] = {
     "org.lineageos.updater",
+    "app.morphe.manager",
     nullptr
 };
 
@@ -257,13 +258,23 @@
     return false;
 }
 
-static bool compute_exempt(bool* is_zygote) {
-    *is_zygote = false;
+static bool compute_exempt(bool* transient_name) {
+    *transient_name = false;
 
     char name[256];
     if (!read_cmdline_name(name, sizeof(name))) return false;
 
-    if (name_is_zygote(name)) { *is_zygote = true; return true; }
+    if (name_is_zygote(name)) { *transient_name = true; return true; }
+
+    // app_process sets --nice-name before starting ART, but earlier libc calls
+    // can reach this filter. Do not pin that temporary name to this PID.
+    // Keep filtering until the final process name is checked against the list.
+    if (strcmp(name, "/system/bin/app_process") == 0 ||
+        strcmp(name, "/system/bin/app_process32") == 0 ||
+        strcmp(name, "/system/bin/app_process64") == 0) {
+        *transient_name = true;
+        return false;
+    }
 
     for (const char* const* p = kAllowlistedPackages; *p; ++p) {
         if (strcmp(name, *p) == 0) return true;
@@ -277,10 +288,10 @@
     pid_t cur = getpid();
     if (cur == cached_pid) return cached_value;
 
-    bool is_zygote = false;
-    bool result = compute_exempt(&is_zygote);
-
-    if (!is_zygote) {
+    bool transient_name = false;
+    bool result = compute_exempt(&transient_name);
+
+    if (!transient_name) {
         cached_value = result;
         cached_pid = cur;
     }
