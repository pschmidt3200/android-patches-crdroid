# Target repository: packages/modules/Bluetooth
# Target: crDroid 17.0
# Preserve explicit LC3 preferences and restore the release-controlled grouped-read compatibility path.
# Retains individual ASE and Volume Control reads when the flag is disabled.

diff --git a/system/bta/le_audio/le_audio_utils.cc b/system/bta/le_audio/le_audio_utils.cc
