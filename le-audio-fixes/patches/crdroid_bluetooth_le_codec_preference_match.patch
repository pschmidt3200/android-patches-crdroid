-    if (ase_config.octets_per_codec_frame.value() != req_config.octets_per_codec_frame.value()) {
+    if (req_config.octets_per_codec_frame &&
+        ase_config.octets_per_codec_frame.value() != req_config.octets_per_codec_frame.value()) {
